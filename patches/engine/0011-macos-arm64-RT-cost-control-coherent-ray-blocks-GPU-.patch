 	{
@@ -1067,8 +1083,8 @@ bool CRayTracerMetal::ApplyAndComposite( const RTFrameParams &params )
 	m_flTimeComposite += ( CFAbsoluteTimeGetCurrent() - t1 ) * 1000.0;
