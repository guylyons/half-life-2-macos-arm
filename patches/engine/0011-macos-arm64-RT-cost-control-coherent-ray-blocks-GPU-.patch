-static ConVar rt_ao_radius( "rt_ao_radius", "96", FCVAR_ARCHIVE, "AO ray length in world units." );
+static ConVar rt_ao_radius( "rt_ao_radius", "64", FCVAR_ARCHIVE, "AO ray length in world units." );
