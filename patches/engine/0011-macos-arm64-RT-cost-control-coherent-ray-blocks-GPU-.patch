@@ -41,7 +41,7 @@ struct Params {
     float shadowStrength; float sunCosAngle; int frame; int debugMode;
     int aoEnabled; int shadowEnabled; int fullW; int fullH;
     int halfW; int halfH; int hasSun; int historyValid;
-    int aoRays; int staticPropInstance; int numShadowBoxes; int pad2;
+    int aoRays; int staticPropInstance; int numShadowBoxes; int coherentBlocks;
 };
 
 // does the ray from o along d (d.z > 0 assumed nothing) cross the box? slab test
@@ -140,7 +140,10 @@ kernel void trace(constant Params& p [[buffer(0)]],
     uint seed = hash(gid.x * 1973u + gid.y * 9277u + uint(p.frame) * 26699u);
     // per-pixel R2 sequence: each pixel walks a low-discrepancy sequence over frames from its own
     // random offset, so the accumulated samples converge faster than white noise
-    uint pix = hash(gid.x * 7919u + gid.y * 104729u);
+    // Directions are shared by 2x2 pixel blocks (coherent rays traverse the BVH together on the
+    // software tracer); the blocks' offsets differ and the sequence advances every frame.
+    uint2 blk = p.coherentBlocks ? (gid / 2u) : gid;
+    uint pix = hash(blk.x * 7919u + blk.y * 104729u);
     float2 r2off = float2(float(pix & 0xFFFFu), float(pix >> 16)) / 65536.0;
 
     float ao = 1.0;
@@ -301,7 +304,7 @@ struct RTParamsGPU
