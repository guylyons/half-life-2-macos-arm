diff --git a/public/rtmetal/iraytracer.h b/public/rtmetal/iraytracer.h
index 90f2081..9185abe 100644
--- a/public/rtmetal/iraytracer.h
+++ b/public/rtmetal/iraytracer.h
@@ -27,6 +27,8 @@ struct RTFrameParams
 	int		m_nResolutionDivisor;		// 1 = full, 2 = half (default)
