+static ConVar rt_coherent( "rt_coherent", "1", FCVAR_ARCHIVE, "Share AO ray directions across 2x2 pixel blocks (faster on software ray tracing; the temporal filter still varies them per frame)." );
+static ConVar rt_budget( "rt_budget", "7", FCVAR_ARCHIVE, "GPU time budget per traced frame in ms; while the tracer is over it, AO uses one ray per pixel instead of rt_ao_rays. 0 = never reduce." );
 static ConVar rt_debug( "rt_debug", "0", 0, "0 off, 1 AO, 2 sun shadows, 3 normals, 4 depth, 7 any dynamic sun hit, 8 world sun hit, 9 both." );
 static ConVar rt_stats( "rt_stats", "0", 0, "Print ray tracing timing to the console periodically." );
 
@@ -706,6 +708,8 @@ void RT_DrawComposite( const CViewSetup &view )
 	pVar = pMat->FindVar( "$rt_divisor", &bFound ); if ( bFound ) pVar->SetIntValue( clamp( rt_divisor.GetInt(), 1, 4 ) );
 	pVar = pMat->FindVar( "$rt_aorays", &bFound ); if ( bFound ) pVar->SetIntValue( clamp( rt_ao_rays.GetInt(), 1, 8 ) );
 	pVar = pMat->FindVar( "$rt_async", &bFound ); if ( bFound ) pVar->SetIntValue( rt_async.GetInt() );
+	pVar = pMat->FindVar( "$rt_coherent", &bFound ); if ( bFound ) pVar->SetIntValue( rt_coherent.GetInt() );
+	pVar = pMat->FindVar( "$rt_budget", &bFound ); if ( bFound ) pVar->SetFloatValue( rt_budget.GetFloat() );
 	CMatRenderContextPtr pRenderContext( materials );
 	pRenderContext->DrawScreenSpaceQuad( pMat );
 
