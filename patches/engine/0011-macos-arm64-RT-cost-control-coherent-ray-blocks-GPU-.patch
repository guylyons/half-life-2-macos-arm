 .../stdshaders/raytracecomposite.cpp          |  4 +++
 public/rtmetal/iraytracer.h                   |  2 ++
 rtmetal/rtmetal.mm                            | 30 ++++++++++++++-----
 4 files changed, 34 insertions(+), 8 deletions(-)

