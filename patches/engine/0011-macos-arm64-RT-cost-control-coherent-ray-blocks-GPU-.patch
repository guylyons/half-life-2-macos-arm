-			m_flTimeResolve / m_nTimedFrames, m_flTimeMetalWall / m_nTimedFrames, m_flTimeMetalGPU / m_nTimedFrames, m_flTimeMetalWait / m_nTimedFrames, m_flTimeDynamic / m_nTimedFrames, m_flTimeComposite / m_nTimedFrames, m_nHalfW, m_nHalfH, m_bAsync ? "async" : "sync", m_nLastInstanceCount, m_nLastSkinnedCount );
+		snprintf( m_szTiming, sizeof( m_szTiming ), "per frame: depth resolve %.2f ms, metal encode %.2f ms (%.2f ms GPU, %.2f ms waited, %.2f ms dynamic), composite %.2f ms; trace %dx%d %s%s; %d instances (%d skinned)",
+			m_flTimeResolve / m_nTimedFrames, m_flTimeMetalWall / m_nTimedFrames, m_flTimeMetalGPU / m_nTimedFrames, m_flTimeMetalWait / m_nTimedFrames, m_flTimeDynamic / m_nTimedFrames, m_flTimeComposite / m_nTimedFrames, m_nHalfW, m_nHalfH, m_bAsync ? "async" : "sync", m_bReducedRays ? ", over budget: 1 AO ray" : "", m_nLastInstanceCount, m_nLastSkinnedCount );
 		m_flTimeResolve = m_flTimeMetalWall = m_flTimeMetalGPU = m_flTimeMetalWait = m_flTimeComposite = m_flTimeDynamic = 0.0; m_nTimedFrames = 0;
 	}
 	return bOK;
