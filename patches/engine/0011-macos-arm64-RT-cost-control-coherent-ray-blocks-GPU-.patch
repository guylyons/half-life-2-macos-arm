@@ -951,6 +964,7 @@ bool CRayTracerMetal::TraceSlot( FrameSlot_t &slot, bool bWaitForDepth )
 		m_flTimeDynamic += ( CFAbsoluteTimeGetCurrent() - tDyn ) * 1000.0;
