+static int EnsureTracerMesh( RTModelTris_t *pTris )
+{
+	if ( !pTris || pTris->bMeshTried )
+		return pTris ? pTris->nMesh : 0;
+	pTris->bMeshTried = true;
+	IRayTracer *pRT = GetRayTracer();
+	if ( !pRT || pTris->indices.Count() < 3 )
+		return 0;
+	pTris->nMesh = pRT->CreateMesh( &pTris->verts[0].x, pTris->verts.Count(), pTris->indices.Base(), pTris->indices.Count() / 3,
+		pTris->bSkinned ? pTris->boneIdx.Base() : NULL, pTris->bSkinned ? pTris->boneWeight.Base() : NULL );
+	return pTris->nMesh;
+}
+
+static void MatrixToRows( const matrix3x4_t &m, float *pOut )
+{
+	memcpy( pOut, m.Base(), 12 * sizeof( float ) );
+}
