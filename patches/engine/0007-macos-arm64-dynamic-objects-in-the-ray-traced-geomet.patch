+static bool IsIdentity( const matrix3x4_t &m )
+{
+	for ( int r = 0; r < 3; r++ )
+		for ( int c = 0; c < 4; c++ )
+			if ( fabsf( m[r][c] - ( r == c ? 1.0f : 0.0f ) ) > 1e-4f )
+				return false;
+	return true;
 }
 
