+#define RTDYN_SKIP( why ) { if ( s_nDumpDynamic ) Msg( "[rt]   skip %d %s (%s): %s\n", pEnt->entindex(), pEnt->GetClassname(), pModel ? modelinfo->GetModelName( pModel ) : "-", why ); continue; }
