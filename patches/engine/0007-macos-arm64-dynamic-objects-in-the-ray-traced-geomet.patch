+// skins a mesh's rest-pose vertices into world space with row-major 3x4 pose-to-world matrices
+kernel void skin(constant uint& nVerts [[buffer(0)]],
+                 device const float4* rest [[buffer(1)]],
+                 device const uchar4* boneIdx [[buffer(2)]],
+                 device const float4* boneWeight [[buffer(3)]],
+                 device const float* bones [[buffer(4)]],
+                 device float4* outVerts [[buffer(5)]],
+                 uint id [[thread_position_in_grid]])
+{
+    if (id >= nVerts) return;
+    float4 p = float4(rest[id].xyz, 1.0);
+    uchar4 b = boneIdx[id]; float4 w = boneWeight[id];
+    float3 r = float3(0.0);
+    for (int i = 0; i < 4; i++) {
+        if (w[i] <= 0.0) continue;
+        device const float* m = bones + uint(b[i]) * 12u;
+        r += w[i] * float3(dot(float4(m[0], m[1], m[2], m[3]), p), dot(float4(m[4], m[5], m[6], m[7]), p), dot(float4(m[8], m[9], m[10], m[11]), p));
+    }
+    outVerts[id] = float4(r, 0.0);
+}
