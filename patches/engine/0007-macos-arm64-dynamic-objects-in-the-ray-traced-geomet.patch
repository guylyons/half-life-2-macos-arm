+// Encodes skinning, BVH builds/refits and the instance structure for this frame's dynamic
+// objects plus the static world. Called on the render thread with m_pAccel valid.
+bool CRayTracerMetal::EncodeDynamicScene( id<MTLCommandBuffer> cb, NSMutableArray *pKeepAlive, id<MTLAccelerationStructure> *ppInstanceAS, NSArray **ppPrimitiveASes, int *pnInstances )
+{
+	std::lock_guard<std::mutex> lock( m_meshMutex );
