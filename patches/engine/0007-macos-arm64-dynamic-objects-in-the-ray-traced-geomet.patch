+//-----------------------------------------------------------------------------
+// Dynamic meshes and instances
+//-----------------------------------------------------------------------------
+id<MTLAccelerationStructure> CRayTracerMetal::BuildPrimitiveAS( MTLPrimitiveAccelerationStructureDescriptor *desc, MTLAccelerationStructureSizes *pSizes )
+{
+	MTLAccelerationStructureSizes sizes = [m_pDevice accelerationStructureSizesWithDescriptor:desc];
+	if ( pSizes ) *pSizes = sizes;
+	id<MTLAccelerationStructure> accel = [m_pDevice newAccelerationStructureWithSize:sizes.accelerationStructureSize];
+	id<MTLBuffer> scratch = [m_pDevice newBufferWithLength:sizes.buildScratchBufferSize options:MTLResourceStorageModePrivate];
+	id<MTLCommandBuffer> cb = [m_pQueue commandBuffer];
+	id<MTLAccelerationStructureCommandEncoder> enc = [cb accelerationStructureCommandEncoder];
+	[enc buildAccelerationStructure:accel descriptor:desc scratchBuffer:scratch scratchBufferOffset:0];
+	[enc endEncoding];
+	[cb commit];
+	[cb waitUntilCompleted];
+	[scratch release];
+	return accel;
+}
+
+MTLPrimitiveAccelerationStructureDescriptor *CRayTracerMetal::MeshDescriptor( const RTMesh_t &mesh, id<MTLBuffer> vb )
+{
+	MTLAccelerationStructureTriangleGeometryDescriptor *geom = [MTLAccelerationStructureTriangleGeometryDescriptor descriptor];
+	geom.vertexBuffer = vb; geom.vertexStride = 16; geom.vertexFormat = MTLAttributeFormatFloat3;
+	geom.indexBuffer = mesh.ib; geom.indexType = MTLIndexTypeUInt32; geom.triangleCount = mesh.nTris;
+	geom.opaque = YES;
+	MTLPrimitiveAccelerationStructureDescriptor *desc = [MTLPrimitiveAccelerationStructureDescriptor descriptor];
+	desc.geometryDescriptors = @[ geom ];
+	if ( mesh.bSkinned )
+		desc.usage = MTLAccelerationStructureUsageRefit;	// skinned copies are refitted every frame
+	return desc;
+}
+
+int CRayTracerMetal::CreateMesh( const float *pVertsXYZ, int nVerts, const unsigned int *pIndices, int nTris, const unsigned char *pBoneIndices4, const float *pBoneWeights4 )
+{
+	if ( !m_bAvailable || nTris <= 0 || nVerts <= 0 )
+		return 0;
+	@autoreleasepool
+	{
+		RTMesh_t mesh;
+		memset( &mesh, 0, sizeof( mesh ) );
+		std::vector<float> padded( (size_t)nVerts * 4 );
+		for ( int i = 0; i < nVerts; i++ ) { padded[i*4] = pVertsXYZ[i*3]; padded[i*4+1] = pVertsXYZ[i*3+1]; padded[i*4+2] = pVertsXYZ[i*3+2]; padded[i*4+3] = 0; }
+		mesh.vb = [m_pDevice newBufferWithBytes:padded.data() length:padded.size() * sizeof( float ) options:MTLResourceStorageModeShared];
+		mesh.ib = [m_pDevice newBufferWithBytes:pIndices length:(size_t)nTris * 3 * sizeof( unsigned int ) options:MTLResourceStorageModeShared];
+		mesh.nVerts = nVerts; mesh.nTris = nTris;
+		mesh.bSkinned = pBoneIndices4 && pBoneWeights4;
+		if ( mesh.bSkinned )
+		{
+			mesh.boneIdx = [m_pDevice newBufferWithBytes:pBoneIndices4 length:(size_t)nVerts * 4 options:MTLResourceStorageModeShared];
+			mesh.boneWeight = [m_pDevice newBufferWithBytes:pBoneWeights4 length:(size_t)nVerts * 4 * sizeof( float ) options:MTLResourceStorageModeShared];
+			// sizes for the per-instance world-space copies (same topology)
+			mesh.sizes = [m_pDevice accelerationStructureSizesWithDescriptor:MeshDescriptor( mesh, mesh.vb )];
+		}
+		else
+		{
+			mesh.rigidAS = BuildPrimitiveAS( MeshDescriptor( mesh, mesh.vb ), &mesh.sizes );
+		}
+		std::lock_guard<std::mutex> lock( m_meshMutex );
+		int id = m_nNextMesh++;
+		m_meshes[id] = mesh;
+		return id;
+	}
+}
+
+void CRayTracerMetal::DestroySkinnedInstance( RTSkinnedInstance_t &inst )
+{
+	[inst.worldVB release]; [inst.boneBuf release]; [inst.scratch release]; [inst.as release];
+	inst.worldVB = nil; inst.boneBuf = nil; inst.scratch = nil; inst.as = nil;
+}
+
+void CRayTracerMetal::DestroyMesh( int nMesh )
+{
+	std::lock_guard<std::mutex> lock( m_meshMutex );
+	auto it = m_meshes.find( nMesh );
+	if ( it == m_meshes.end() )
+		return;
+	RTMesh_t &m = it->second;
+	[m.vb release]; [m.ib release]; [m.boneIdx release]; [m.boneWeight release]; [m.rigidAS release];
+	m_meshes.erase( it );
+	for ( auto sk = m_skinned.begin(); sk != m_skinned.end(); )
+	{
+		if ( sk->second.nMesh == nMesh ) { DestroySkinnedInstance( sk->second ); sk = m_skinned.erase( sk ); }
+		else ++sk;
+	}
+}
+
+void CRayTracerMetal::SetInstances( const RTInstance *pInstances, int nInstances, const float *pBonePool, int nPoolFloats )
+{
+	std::lock_guard<std::mutex> lock( m_meshMutex );
+	m_pendingInstances.assign( pInstances, pInstances + ( nInstances > 0 ? nInstances : 0 ) );
+	m_pendingBones.assign( pBonePool, pBonePool + ( nPoolFloats > 0 ? nPoolFloats : 0 ) );
+	m_bPendingInstances = true;
+}
+
+static inline void PackTransform( const float *m /* row-major 3x4 */, MTLPackedFloat4x3 *pOut )
+{
+	for ( int c = 0; c < 4; c++ )
+	{
+		pOut->columns[c].x = m[0*4 + c];
+		pOut->columns[c].y = m[1*4 + c];
+		pOut->columns[c].z = m[2*4 + c];
+	}
+}
