+// Collects this frame's dynamic objects and hands them to the tracer.
+static void UpdateDynamicInstances( const CViewSetup &view )
+{
+	IRayTracer *pRT = GetRayTracer();
+	if ( !pRT )
+		return;
+	s_Instances.RemoveAll();
+	s_BonePool.RemoveAll();
+	if ( rt_dynamic.GetBool() )
+	{
+		C_BaseAnimating::AutoAllowBoneAccess boneaccess( true, false );
+		C_BasePlayer *pLocal = C_BasePlayer::GetLocalPlayer();
+		float flRangeSqr = rt_dynamic_range.GetFloat() * rt_dynamic_range.GetFloat();
+		int nSeen = 0;
+		for ( C_BaseEntity *pEnt = ClientEntityList().FirstBaseEntity(); pEnt; pEnt = ClientEntityList().NextBaseEntity( pEnt ) )
+		{
+			nSeen++;
+			const model_t *pModel = pEnt->GetModel();
+			if ( pEnt == pLocal || pEnt->entindex() == 0 )
+				continue;
+			if ( !pModel )
+				continue;
+			if ( pEnt->IsDormant() ) RTDYN_SKIP( "dormant" );
+			if ( pEnt->IsEffectActive( EF_NODRAW ) ) RTDYN_SKIP( "nodraw" );
+			if ( pEnt->GetRenderMode() == kRenderNone ) RTDYN_SKIP( "rendermode none" );
+			if ( ( pEnt->GetAbsOrigin() - view.origin ).LengthSqr() > flRangeSqr ) RTDYN_SKIP( "out of range" );
+			int nType = modelinfo->GetModelType( pModel );
+			RTInstance inst;
+			inst.m_nKey = (unsigned int)pEnt->GetRefEHandle().ToInt();
+			inst.m_nBoneOffset = -1;
+			inst.m_nBones = 0;
+			if ( nType == mod_brush )
+			{
+				const char *pName = modelinfo->GetModelName( pModel );
+				if ( !pName || pName[0] != '*' ) RTDYN_SKIP( "brush model name" );
+				int nIdx = atoi( pName + 1 );
+				if ( nIdx <= 0 || nIdx >= s_BrushMeshes.Count() || !s_BrushMeshes[nIdx] ) RTDYN_SKIP( "no brush mesh" );
+				if ( s_nDumpDynamic ) Msg( "[rt]   brush %d %s %s\n", pEnt->entindex(), pEnt->GetClassname(), pName );
+				inst.m_nMesh = s_BrushMeshes[nIdx];
+				MatrixToRows( pEnt->RenderableToWorldTransform(), inst.m_modelToWorld );
+				s_Instances.AddToTail( inst );
+				continue;
+			}
+			if ( nType != mod_studio ) RTDYN_SKIP( "not studio/brush" );
+			C_BaseAnimating *pAnim = pEnt->GetBaseAnimating();
+			if ( !pAnim ) RTDYN_SKIP( "not animating" );
+			if ( pAnim->IsViewModel() ) RTDYN_SKIP( "viewmodel" );
+			if ( !pAnim->ShouldDraw() ) RTDYN_SKIP( "ShouldDraw false" );
+			RTModelTris_t *pTris = const_cast<RTModelTris_t *>( GetModelTriangles( pModel, pAnim->GetSkin(), pAnim->GetBody() ) );
+			int nMesh = EnsureTracerMesh( pTris );
+			if ( !nMesh ) RTDYN_SKIP( "no mesh" );
+			if ( s_nDumpDynamic ) Msg( "[rt]   %s %d %s %s (%d tris)\n", pTris->bSkinned ? "skinned" : "rigid", pEnt->entindex(), pEnt->GetClassname(), modelinfo->GetModelName( pModel ), pTris->indices.Count() / 3 );
+			inst.m_nMesh = nMesh;
+			if ( pTris->bSkinned )
+			{
+				if ( rt_dynamic.GetInt() < 2 )
+					continue;
+				studiohdr_t *pHdr = modelinfo->GetStudiomodel( pModel );
+				if ( !pHdr )
+					continue;
+				static matrix3x4_t s_Bones[MAXSTUDIOBONES];
+				if ( !pAnim->SetupBones( s_Bones, MAXSTUDIOBONES, BONE_USED_BY_ANYTHING, gpGlobals->curtime ) )
+					continue;
+				inst.m_nBoneOffset = s_BonePool.Count();
+				inst.m_nBones = pHdr->numbones;
+				bool bFinite = true;
+				for ( int i = 0; i < pHdr->numbones; i++ )
+				{
+					matrix3x4_t poseToWorld;
+					ConcatTransforms( s_Bones[i], pHdr->pBone( i )->poseToBone, poseToWorld );
+					int at = s_BonePool.AddMultipleToTail( 12 );
+					MatrixToRows( poseToWorld, &s_BonePool[at] );
+					for ( int k = 0; k < 12; k++ ) if ( !IsFinite( s_BonePool[at + k] ) ) bFinite = false;
+				}
+				if ( !bFinite )
+				{
+					s_BonePool.SetCountNonDestructively( inst.m_nBoneOffset );
+					RTDYN_SKIP( "non-finite bones" );
+				}
+				SetIdentityMatrix( *(matrix3x4_t *)inst.m_modelToWorld );
+			}
+			else
+			{
+				MatrixToRows( pAnim->RenderableToWorldTransform(), inst.m_modelToWorld );
+			}
+			s_Instances.AddToTail( inst );
+		}
+	}
+	if ( s_nDumpDynamic )
+	{
+		Msg( "[rt] %d instances this frame (%d bone floats)\n", s_Instances.Count(), s_BonePool.Count() );
+		s_nDumpDynamic = 0;
+	}
+	pRT->SetInstances( s_Instances.Base(), s_Instances.Count(), s_BonePool.Base(), s_BonePool.Count() );
+}
