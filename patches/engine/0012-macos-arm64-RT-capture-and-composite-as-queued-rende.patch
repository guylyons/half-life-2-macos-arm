-				RTFrameParams fp;
-				memset( &fp, 0, sizeof( fp ) );
-				const VMatrix &w2p = params[RT_WORLDTOPROJ]->GetMatrixValue();
-				const VMatrix &p2w = params[RT_PROJTOWORLD]->GetMatrixValue();
-				memcpy( fp.m_worldToProjection, w2p.Base(), sizeof( fp.m_worldToProjection ) );
-				memcpy( fp.m_projectionToWorld, p2w.Base(), sizeof( fp.m_projectionToWorld ) );
-				params[RT_CAMERAPOS]->GetVecValue( fp.m_cameraPos, 3 );
-				params[RT_SUNDIR]->GetVecValue( fp.m_sunDir, 3 );
-				fp.m_flAORadius = params[RT_AORADIUS]->GetFloatValue();
-				fp.m_flAOStrength = params[RT_AOSTRENGTH]->GetFloatValue();
-				fp.m_flShadowStrength = params[RT_SHADOWSTRENGTH]->GetFloatValue();
-				fp.m_flSunAngleDeg = params[RT_SUNANGLE]->GetFloatValue();
-				fp.m_nFrame = params[RT_FRAME]->GetIntValue();
-				fp.m_nDebugMode = params[RT_DEBUG]->GetIntValue();
-				fp.m_bAO = params[RT_AO]->GetIntValue();
-				fp.m_bShadows = params[RT_SHADOWS]->GetIntValue();
-				fp.m_nResolutionDivisor = params[RT_DIVISOR]->GetIntValue();
-				fp.m_nAORays = params[RT_AORAYS]->GetIntValue();
-				fp.m_bAsync = params[RT_ASYNC]->GetIntValue();
-				fp.m_bCoherent = params[RT_COHERENT]->GetIntValue();
-				fp.m_flBudgetMs = params[RT_BUDGET]->GetFloatValue();
-				pRT->ApplyAndComposite( fp );
-			}
-		}
-		Draw();
-	}
-END_SHADER
