-// Pixels per point of the display the window is on (2.0 on Retina displays, 1.0 otherwise).
-float CSDLMgr::GetDisplayScale()
+// Pixels per point of an SDL display (2.0 on Retina displays, 1.0 otherwise).
+float CSDLMgr::GetDisplayScale( int nDisplay )
 {
+#ifdef OSX
+	// Match the SDL display to a CoreGraphics display by its bounds (both in points),
+	// then compare the current mode's pixel and point widths.
+	SDL_Rect rect;
+	if ( nDisplay >= 0 && SDL_GetDisplayBounds( nDisplay, &rect ) == 0 )
+	{
+		CGDirectDisplayID displays[16];
+		uint32_t nDisplays = 0;
+		if ( CGGetActiveDisplayList( 16, displays, &nDisplays ) == kCGErrorSuccess )
+		{
+			for ( uint32_t i = 0; i < nDisplays; i++ )
+			{
+				CGRect bounds = CGDisplayBounds( displays[i] );
+				if ( (int)bounds.origin.x != rect.x || (int)bounds.origin.y != rect.y )
+					continue;
+				float flScale = 1.0f;
+				CGDisplayModeRef mode = CGDisplayCopyDisplayMode( displays[i] );
+				if ( mode )
+				{
+					size_t ptW = CGDisplayModeGetWidth( mode );
+					size_t pxW = CGDisplayModeGetPixelWidth( mode );
+					if ( ptW > 0 && pxW > ptW )
+						flScale = (float)pxW / (float)ptW;
+					CGDisplayModeRelease( mode );
+				}
+				return flScale;
+			}
+		}
+	}
+#endif
+	// fall back to the window's own backing scale
 	if ( !m_Window )
 		return 1.0f;
 	int ww = 0, wh = 0, dw = 0, dh = 0;
