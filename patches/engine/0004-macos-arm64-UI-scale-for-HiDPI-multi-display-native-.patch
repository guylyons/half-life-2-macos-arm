+			}
+		}
+		if ( nDisplayWidth > 0 && nDisplayHeight > 0 )
+		{
+			if ( ( config.m_VideoMode.m_Width > (int)nDisplayWidth ) || ( config.m_VideoMode.m_Height > (int)nDisplayHeight ) )
