 	MaterialVideoMode_t videoMode;
 	materials->GetDisplayMode( videoMode );
+#if defined( USE_SDL ) && !defined( SWDS )
+	// The adapter's display is not necessarily the one we go fullscreen on; allow
+	// the largest native pixel size of any display (the mode change path re-validates).
+	for ( int i = 0; i < SDL_GetNumVideoDisplays(); i++ )
+	{
+		uint w = 0, h = 0, hz = 0;
+		g_pLauncherMgr->GetNativeDisplayInfo( i, w, h, hz );
+		if ( (int)w > videoMode.m_Width || ( (int)w == videoMode.m_Width && (int)h > videoMode.m_Height ) )
+		{
+			videoMode.m_Width = w;
