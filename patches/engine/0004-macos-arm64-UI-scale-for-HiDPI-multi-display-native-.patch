 engine/sys_mainwind.cpp                   | 20 ++++----
 engine/vgui_baseui_interface.cpp          |  7 ++-
 game/client/in_mouse.cpp                  |  4 +-
 public/VGuiMatSurface/IMatSystemSurface.h |  4 ++
 vguimatsurface/Cursor.cpp                 | 23 ++++++++-
 vguimatsurface/Input.cpp                  | 11 +++-
 vguimatsurface/MatSystemSurface.cpp       | 61 ++++++++++++++++++++++-
 vguimatsurface/MatSystemSurface.h         |  6 +++
