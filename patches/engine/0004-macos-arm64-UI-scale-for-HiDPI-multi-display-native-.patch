diff --git a/appframework/glmrendererinfo_osx.mm b/appframework/glmrendererinfo_osx.mm
index c622240..2a3aa3d 100644
--- a/appframework/glmrendererinfo_osx.mm
+++ b/appframework/glmrendererinfo_osx.mm
@@ -522,6 +522,8 @@ extern "C" int DisplayInfoSortFunction( GLMDisplayInfo* const *A, GLMDisplayInfo
 }
 
 
+extern "C" int DisplayModeSortFunction( GLMDisplayMode * const *A, GLMDisplayMode * const *B );
+
 void	GLMRendererInfo::PopulateDisplays( void )
 {
 	Assert( !m_displays );
@@ -555,6 +557,38 @@ void	GLMRendererInfo::PopulateDisplays( void )
 	{
 		(*this->m_displays)[i]->PopulateModes();
 	}
+
+	// The engine only ever asks display 0 for its mode list, but the game can go
+	// fullscreen on any display (sdl_displayindex). Merge every display's modes
+	// into display 0 so e.g. the Retina panel's native size is offered while an
+	// external monitor is the main display.
+	if ( m_displays->Count() > 1 )
+	{
+		GLMDisplayInfo *pPrimary = (*m_displays)[0];
+		for ( int i = 1; i < m_displays->Count(); i++ )
+		{
+			GLMDisplayInfo *pOther = (*m_displays)[i];
+			FOR_EACH_VEC( (*pOther->m_modes), j )
+			{
+				GLMDisplayMode *pMode = (*pOther->m_modes)[j];
+				bool bDuplicate = false;
+				FOR_EACH_VEC( (*pPrimary->m_modes), k )
+				{
+					GLMDisplayMode *pHave = (*pPrimary->m_modes)[k];
+					if ( pHave->m_info.m_modePixelWidth == pMode->m_info.m_modePixelWidth && pHave->m_info.m_modePixelHeight == pMode->m_info.m_modePixelHeight )
+					{
+						bDuplicate = true;
+						break;
+					}
+				}
+				if ( !bDuplicate )
+				{
+					pPrimary->m_modes->AddToTail( new GLMDisplayMode( pMode->m_info.m_modePixelWidth, pMode->m_info.m_modePixelHeight, pMode->m_info.m_modeRefreshHz ) );
+				}
+			}
+		}
+		pPrimary->m_modes->Sort( DisplayModeSortFunction );
+	}
 }
 
 const char *CheesyRendererDecode( uint value )
@@ -1443,8 +1477,24 @@ GLMDisplayInfo::GLMDisplayInfo( CGDirectDisplayID displayID, CGOpenGLDisplayMask
 	m_info.m_glDisplayMask			= displayMask;
 	
 	// extract info about this display such as pixel width and height
+	// CGDisplayPixelsWide/High return points on HiDPI displays; ask the current
+	// mode for the real pixel size so "display mode" / clamping code sees the
+	// native resolution (e.g. 3024x1964 rather than 1512x982).
 	m_info.m_displayPixelWidth		= (uint)CGDisplayPixelsWide( m_info.m_cgDisplayID );
 	m_info.m_displayPixelHeight		= (uint)CGDisplayPixelsHigh( m_info.m_cgDisplayID );
+	{
+		CGDisplayModeRef curMode = CGDisplayCopyDisplayMode( m_info.m_cgDisplayID );
+		if ( curMode )
+		{
+			size_t pxW = CGDisplayModeGetPixelWidth( curMode ), pxH = CGDisplayModeGetPixelHeight( curMode );
+			if ( pxW > m_info.m_displayPixelWidth && pxH > m_info.m_displayPixelHeight )
+			{
+				m_info.m_displayPixelWidth = (uint)pxW;
+				m_info.m_displayPixelHeight = (uint)pxH;
+			}
+			CGDisplayModeRelease( curMode );
+		}
+	}
 
 	m_modes = NULL;
 }
