+		iTall = (int)( iTall / flScale + 0.5f );
+	}
+}
+
+//-----------------------------------------------------------------------------
+// UI scale. vgui_scale 0 (default) = automatic: render pixels per window point,
+// so at a HiDPI native resolution (e.g. 3024x1964 on a 1512x982-point display)
+// the UI is laid out in points and drawn 2x, instead of being tiny.
+//-----------------------------------------------------------------------------
+static ConVar vgui_scale( "vgui_scale", "0", FCVAR_ARCHIVE, "UI scale factor. 0 = automatic (render pixels per window point), otherwise 1..4.", true, 0.0f, true, 4.0f );
+
+float CMatSystemSurface::ComputeUIScale()
+{
+	float flScale = vgui_scale.GetFloat();
+	if ( flScale <= 0.0f )
+	{
+		flScale = 1.0f;
+#if defined( USE_SDL )
+		int nBackBufferWidth = 0, nBackBufferHeight = 0;
+		g_pMaterialSystem->GetBackBufferDimensions( nBackBufferWidth, nBackBufferHeight );
+		int nWindowWidth = 0, nWindowHeight = 0;
+		if ( g_pLauncherMgr && g_pLauncherMgr->GetWindowRef() )
+		{
+			SDL_GetWindowSize( (SDL_Window *)g_pLauncherMgr->GetWindowRef(), &nWindowWidth, &nWindowHeight );
+		}
+		if ( nWindowWidth > 0 && nBackBufferWidth > nWindowWidth )
+		{
+			flScale = (float)nBackBufferWidth / (float)nWindowWidth;
+		}
+#endif
+	}
+	return clamp( flScale, 1.0f, 4.0f );
+}
+
+float CMatSystemSurface::GetUIScale()
+{
+	if ( m_flUIScale <= 0.0f )
+	{
+		m_flUIScale = ComputeUIScale();
+	}
+	return m_flUIScale;
 }
 
 bool CMatSystemSurface::ForceScreenSizeOverride( bool bState, int wide, int tall )
@@ -4505,7 +4560,11 @@ void CMatSystemSurface::PushFullscreenViewport()
