+//========= Ray tracing layer: client side (macOS arm64 port) ===================
+// - At map load, extracts the world geometry (brush faces and displacements of
+//   the world model) from the .bsp and hands it to the Metal ray tracer.
+// - Reads light_environment for the sun direction.
+// - After the 3D scene, draws a fullscreen quad with the "RayTraceComposite"
+//   shader, whose draw pass runs the tracer on the render thread. Camera
+//   matrices and settings travel as material vars.
+//=============================================================================
+#include "cbase.h"
+#include "rt_layer.h"
+#include "bspfile.h"
+#include "bspflags.h"
+#include "filesystem.h"
+#include "ivrenderview.h"
+#include "materialsystem/imaterialsystem.h"
+#include "materialsystem/imaterialvar.h"
+#include "materialsystem/imaterial.h"
+#include "tier1/KeyValues.h"
+#include "tier1/interface.h"
+#include "mathlib/vmatrix.h"
+#include "rtmetal/iraytracer.h"
+#include "view_shared.h"
+
+#include "tier0/memdbgon.h"
+
+#ifdef OSX
+
+static ConVar rt_enable( "rt_enable", "1", FCVAR_ARCHIVE, "Ray-traced lighting layer (ambient occlusion and sun shadows)." );
+static ConVar rt_ao( "rt_ao", "1", FCVAR_ARCHIVE, "Ray-traced ambient occlusion." );
+static ConVar rt_shadows( "rt_shadows", "0", FCVAR_ARCHIVE, "Ray-traced sun shadows (world only for now: mostly duplicates the lightmaps, so off by default)." );
+static ConVar rt_ao_radius( "rt_ao_radius", "96", FCVAR_ARCHIVE, "AO ray length in world units." );
+static ConVar rt_ao_strength( "rt_ao_strength", "0.8", FCVAR_ARCHIVE, "AO darkening, 0..1." );
+static ConVar rt_shadow_strength( "rt_shadow_strength", "0.6", FCVAR_ARCHIVE, "Sun shadow darkening, 0..1." );
+static ConVar rt_sun_angle( "rt_sun_angle", "1.0", FCVAR_ARCHIVE, "Sun angular radius in degrees (soft shadows)." );
+static ConVar rt_divisor( "rt_divisor", "2", FCVAR_ARCHIVE, "Trace resolution divisor (1 = full, 2 = half)." );
+static ConVar rt_ao_rays( "rt_ao_rays", "2", FCVAR_ARCHIVE, "AO rays per pixel per frame." );
+static ConVar rt_debug( "rt_debug", "0", 0, "0 off, 1 AO, 2 shadows, 3 normals, 4 depth." );
+static ConVar rt_stats( "rt_stats", "0", 0, "Print ray tracing timing to the console periodically." );
+
+static IRayTracer *s_pRayTracer = NULL;
+static bool s_bTriedLoad = false;
+static IMaterial *s_pCompositeMaterial = NULL;
+static IMaterial *s_pCaptureMaterial = NULL;
+static Vector s_vSunDir( 0, 0, 0 );
+static bool s_bWorldLoaded = false;
+static int s_nFrame = 0;
+
+static IRayTracer *GetRayTracer()
+{
+	if ( !s_bTriedLoad )
+	{
+		s_bTriedLoad = true;
+		CSysModule *pModule = Sys_LoadModule( "rtmetal" );
+		if ( pModule )
+		{
+			CreateInterfaceFn factory = Sys_GetFactory( pModule );
+			if ( factory )
+				s_pRayTracer = (IRayTracer *)factory( RAYTRACER_INTERFACE_VERSION, NULL );
+		}
+		if ( s_pRayTracer && !s_pRayTracer->Init() )
+			s_pRayTracer = NULL;
+	}
+	return s_pRayTracer;
+}
+
+//-----------------------------------------------------------------------------
+// BSP world geometry extraction
+//-----------------------------------------------------------------------------
+template <class T> static const T *Lump( const byte *pBase, const dheader_t *pHeader, int nLump, int *pCount )
+{
+	const lump_t &l = pHeader->lumps[nLump];
+	*pCount = l.filelen / (int)sizeof( T );
+	return (const T *)( pBase + l.fileofs );
+}
+
+static bool ExtractWorldGeometry( const char *pMapName, CUtlVector<float> &verts, CUtlVector<unsigned int> &indices )
+{
+	CUtlBuffer buf;
+	if ( !filesystem->ReadFile( pMapName, "GAME", buf ) )
+		return false;
+	const byte *pBase = (const byte *)buf.Base();
+	const dheader_t *pHeader = (const dheader_t *)pBase;
+	if ( pHeader->ident != IDBSPHEADER )
+		return false;
+
+	int nVerts, nEdges, nSurfEdges, nFaces, nTexInfo, nTexData, nModels, nDispInfo, nDispVerts;
+	const dvertex_t *pVerts = Lump<dvertex_t>( pBase, pHeader, LUMP_VERTEXES, &nVerts );
+	const dedge_t *pEdges = Lump<dedge_t>( pBase, pHeader, LUMP_EDGES, &nEdges );
+	const int *pSurfEdges = Lump<int>( pBase, pHeader, LUMP_SURFEDGES, &nSurfEdges );
+	const dface_t *pFaces = Lump<dface_t>( pBase, pHeader, LUMP_FACES, &nFaces );
+	const texinfo_t *pTexInfo = Lump<texinfo_t>( pBase, pHeader, LUMP_TEXINFO, &nTexInfo );
+	const dtexdata_t *pTexData = Lump<dtexdata_t>( pBase, pHeader, LUMP_TEXDATA, &nTexData );
+	const dmodel_t *pModels = Lump<dmodel_t>( pBase, pHeader, LUMP_MODELS, &nModels );
+	const ddispinfo_t *pDispInfo = Lump<ddispinfo_t>( pBase, pHeader, LUMP_DISPINFO, &nDispInfo );
+	const CDispVert *pDispVerts = Lump<CDispVert>( pBase, pHeader, LUMP_DISP_VERTS, &nDispVerts );
+	int nStringTable, nStringData;
+	const int *pStringTable = Lump<int>( pBase, pHeader, LUMP_TEXDATA_STRING_TABLE, &nStringTable );
+	const char *pStringData = Lump<char>( pBase, pHeader, LUMP_TEXDATA_STRING_DATA, &nStringData );
+	if ( nModels < 1 || nFaces < 1 )
+		return false;
+
+	const int nSkipFlags = SURF_SKY | SURF_SKY2D | SURF_NODRAW | SURF_TRIGGER | SURF_HINT | SURF_SKIP | SURF_TRANS;
+	const dmodel_t &world = pModels[0];
+	CUtlVector<Vector> faceVerts;
+	int nSkippedTrans = 0;
+
+	for ( int f = world.firstface; f < world.firstface + world.numfaces && f < nFaces; f++ )
+	{
+		const dface_t &face = pFaces[f];
+		if ( face.texinfo < 0 || face.texinfo >= nTexInfo )
+			continue;
+		const texinfo_t &ti = pTexInfo[face.texinfo];
+		if ( ti.flags & nSkipFlags )
+		{
+			if ( ti.flags & SURF_TRANS ) nSkippedTrans++;
+			continue;
+		}
+		if ( ti.texdata >= 0 && ti.texdata < nTexData )
+		{
+			int nameIdx = pTexData[ti.texdata].nameStringTableID;
+			if ( nameIdx >= 0 && nameIdx < nStringTable )
+			{
+				const char *pName = pStringData + pStringTable[nameIdx];
+				if ( !V_strnicmp( pName, "tools/", 6 ) )
+					continue;
+			}
+		}
+
+		// gather the face polygon
+		faceVerts.RemoveAll();
+		for ( int e = 0; e < face.numedges; e++ )
+		{
+			int se = pSurfEdges[face.firstedge + e];
+			int v = ( se >= 0 ) ? pEdges[se].v[0] : pEdges[-se].v[1];
+			if ( v >= 0 && v < nVerts )
+				faceVerts.AddToTail( pVerts[v].point );
+		}
+		if ( faceVerts.Count() < 3 )
+			continue;
+
+		if ( face.dispinfo >= 0 && face.dispinfo < nDispInfo && faceVerts.Count() == 4 )
+		{
+			// displacement: rotate the quad so the corner nearest startPosition is first, then tessellate
+			const ddispinfo_t &disp = pDispInfo[face.dispinfo];
+			int start = 0; float bestDist = 1e30f;
+			for ( int i = 0; i < 4; i++ )
+			{
+				float d = ( faceVerts[i] - disp.startPosition ).LengthSqr();
+				if ( d < bestDist ) { bestDist = d; start = i; }
+			}
+			Vector c[4];
+			for ( int i = 0; i < 4; i++ ) c[i] = faceVerts[( start + i ) % 4];
+			int side = ( 1 << disp.power ) + 1;
+			if ( disp.m_iDispVertStart < 0 || disp.m_iDispVertStart + side * side > nDispVerts )
+				continue;
+			unsigned int base = verts.Count() / 3;
+			for ( int row = 0; row < side; row++ )
+			{
+				float t = (float)row / (float)( side - 1 );
+				Vector left = c[0] + ( c[1] - c[0] ) * t;
+				Vector right = c[3] + ( c[2] - c[3] ) * t;
+				for ( int col = 0; col < side; col++ )
+				{
+					float s = (float)col / (float)( side - 1 );
+					Vector p = left + ( right - left ) * s;
+					const CDispVert &dv = pDispVerts[disp.m_iDispVertStart + row * side + col];
+					p += dv.m_vVector * dv.m_flDist;
+					verts.AddToTail( p.x ); verts.AddToTail( p.y ); verts.AddToTail( p.z );
+				}
+			}
+			for ( int row = 0; row < side - 1; row++ )
+			{
+				for ( int col = 0; col < side - 1; col++ )
+				{
+					unsigned int a = base + row * side + col, b = a + 1, cc = a + side, d = cc + 1;
+					indices.AddToTail( a ); indices.AddToTail( b ); indices.AddToTail( cc );
+					indices.AddToTail( b ); indices.AddToTail( d ); indices.AddToTail( cc );
+				}
+			}
+			continue;
+		}
+
+		// plain polygon: fan
+		unsigned int base = verts.Count() / 3;
+		for ( int i = 0; i < faceVerts.Count(); i++ )
+		{
+			verts.AddToTail( faceVerts[i].x ); verts.AddToTail( faceVerts[i].y ); verts.AddToTail( faceVerts[i].z );
+		}
+		for ( int i = 1; i + 1 < faceVerts.Count(); i++ )
+		{
+			indices.AddToTail( base ); indices.AddToTail( base + i ); indices.AddToTail( base + i + 1 );
+		}
+	}
+	return indices.Count() >= 3;
+}
+
+//-----------------------------------------------------------------------------
+// Sun direction from light_environment
+//-----------------------------------------------------------------------------
+static Vector FindSunDirection()
+{
+	const char *pEnts = engine->GetMapEntitiesString();
+	if ( !pEnts )
+		return Vector( 0, 0, 0 );
+	const char *pFound = V_stristr( pEnts, "\"light_environment\"" );
+	if ( !pFound )
+		return Vector( 0, 0, 0 );
+	// back up to the opening brace of this entity, then parse its keys
+	const char *pStart = pFound;
+	while ( pStart > pEnts && *pStart != '{' ) pStart--;
+	const char *pEnd = strchr( pFound, '}' );
+	if ( !pEnd )
+		return Vector( 0, 0, 0 );
+	CUtlString block( pStart, pEnd - pStart );
+	KeyValues *pKV = new KeyValues( "ent" );
+	pKV->LoadFromBuffer( "ents", CUtlString( "\"ent\"\n" ) + block + "\n}\n" );
+	QAngle angles( 0, 0, 0 );
+	const char *pAngles = pKV->GetString( "angles", "0 0 0" );
+	sscanf( pAngles, "%f %f %f", &angles.x, &angles.y, &angles.z );
+	float pitch = angles.x;
+	if ( pKV->FindKey( "pitch" ) )
+		pitch = pKV->GetFloat( "pitch" );
+	else
+		pitch = -pitch;
+	pKV->deleteThis();
+	// light_environment's pitch is inverted relative to QAngle: negative = light shines downward,
+	// so AngleVectors with the raw pitch yields the direction toward the sun.
+	Vector fwd;
+	AngleVectors( QAngle( pitch, angles.y, 0 ), &fwd );
+	return fwd.Normalized();
+}
+
+//-----------------------------------------------------------------------------
+// Game system: map load / unload
+//-----------------------------------------------------------------------------
+class CRTLayerSystem : public CAutoGameSystem
+{
+public:
+	CRTLayerSystem() : CAutoGameSystem( "RTLayer" ) {}
+
+	virtual void LevelInitPostEntity() OVERRIDE
+	{
+		s_bWorldLoaded = false;
+		s_vSunDir.Init();
+		IRayTracer *pRT = GetRayTracer();
+		if ( !pRT )
+			return;
+		double t0 = Plat_FloatTime();
+		CUtlVector<float> verts; CUtlVector<unsigned int> indices;
+		if ( !ExtractWorldGeometry( engine->GetLevelName(), verts, indices ) )
+		{
+			Warning( "[rt] could not extract world geometry from %s\n", engine->GetLevelName() );
+			return;
+		}
+		pRT->SetWorldGeometry( verts.Base(), verts.Count() / 3, indices.Base(), indices.Count() / 3 );
+		s_vSunDir = FindSunDirection();
+		s_bWorldLoaded = true;
+		s_nFrame = 0;
+		Msg( "[rt] %s: %d triangles (%.0f ms), sun dir %.2f %.2f %.2f\n", engine->GetLevelName(), indices.Count() / 3, ( Plat_FloatTime() - t0 ) * 1000.0, s_vSunDir.x, s_vSunDir.y, s_vSunDir.z );
+	}
+
+	virtual void LevelShutdownPreEntity() OVERRIDE
+	{
+		s_bWorldLoaded = false;
+		if ( s_pRayTracer )
+			s_pRayTracer->ClearWorld();
+	}
+};
+static CRTLayerSystem s_RTLayerSystem;
+
+//-----------------------------------------------------------------------------
+// Per-frame composite
+//-----------------------------------------------------------------------------
+static IMaterial *GetCompositeMaterial()
+{
+	if ( !s_pCompositeMaterial )
+	{
+		KeyValues *pKV = new KeyValues( "RayTraceComposite" );
+		pKV->SetInt( "$rt_mode", 1 );
+		s_pCompositeMaterial = materials->CreateMaterial( "__rt_composite", pKV );
+		if ( s_pCompositeMaterial )
+			s_pCompositeMaterial->IncrementReferenceCount();
+	}
+	return s_pCompositeMaterial;
+}
+
+static IMaterial *GetCaptureMaterial()
+{
+	if ( !s_pCaptureMaterial )
+	{
+		KeyValues *pKV = new KeyValues( "RayTraceComposite" );
+		pKV->SetInt( "$rt_mode", 0 );
+		s_pCaptureMaterial = materials->CreateMaterial( "__rt_capture", pKV );
+		if ( s_pCaptureMaterial )
+			s_pCaptureMaterial->IncrementReferenceCount();
+	}
+	return s_pCaptureMaterial;
+}
+
+void RT_CaptureDepth()
+{
+	if ( !rt_enable.GetBool() || !s_bWorldLoaded )
+		return;
+	if ( !GetRayTracer() )
+		return;
+	IMaterial *pMat = GetCaptureMaterial();
+	if ( !pMat )
+		return;
+	bool bFound;
+	IMaterialVar *pVar = pMat->FindVar( "$rt_divisor", &bFound ); if ( bFound ) pVar->SetIntValue( clamp( rt_divisor.GetInt(), 1, 4 ) );
+	CMatRenderContextPtr pRenderContext( materials );
+	pRenderContext->DrawScreenSpaceQuad( pMat );
+}
+
+void RT_DrawComposite( const CViewSetup &view )
+{
+	if ( !rt_enable.GetBool() || !s_bWorldLoaded )
+		return;
+	IRayTracer *pRT = GetRayTracer();
+	if ( !pRT )
+		return;
+	IMaterial *pMat = GetCompositeMaterial();
+	if ( !pMat )
+		return;
+
+	VMatrix worldToView, viewToProj, worldToProj, worldToPixels;
+	render->GetMatricesForView( view, &worldToView, &viewToProj, &worldToProj, &worldToPixels );
+	VMatrix projToWorld;
+	MatrixInverseGeneral( worldToProj, projToWorld );
+	bool bFound;
+	IMaterialVar *pVar;
+	pVar = pMat->FindVar( "$rt_worldtoproj", &bFound ); if ( bFound ) pVar->SetMatrixValue( worldToProj );
+	pVar = pMat->FindVar( "$rt_projtoworld", &bFound ); if ( bFound ) pVar->SetMatrixValue( projToWorld );
+	pVar = pMat->FindVar( "$rt_camerapos", &bFound ); if ( bFound ) pVar->SetVecValue( view.origin.Base(), 3 );
+	pVar = pMat->FindVar( "$rt_sundir", &bFound ); if ( bFound ) pVar->SetVecValue( s_vSunDir.Base(), 3 );
+	pVar = pMat->FindVar( "$rt_aoradius", &bFound ); if ( bFound ) pVar->SetFloatValue( rt_ao_radius.GetFloat() );
+	pVar = pMat->FindVar( "$rt_aostrength", &bFound ); if ( bFound ) pVar->SetFloatValue( rt_ao_strength.GetFloat() );
+	pVar = pMat->FindVar( "$rt_shadowstrength", &bFound ); if ( bFound ) pVar->SetFloatValue( rt_shadow_strength.GetFloat() );
+	pVar = pMat->FindVar( "$rt_sunangle", &bFound ); if ( bFound ) pVar->SetFloatValue( rt_sun_angle.GetFloat() );
+	pVar = pMat->FindVar( "$rt_frame", &bFound ); if ( bFound ) pVar->SetIntValue( s_nFrame++ );
+	pVar = pMat->FindVar( "$rt_debug", &bFound ); if ( bFound ) pVar->SetIntValue( rt_debug.GetInt() );
+	pVar = pMat->FindVar( "$rt_ao", &bFound ); if ( bFound ) pVar->SetIntValue( rt_ao.GetInt() );
+	pVar = pMat->FindVar( "$rt_shadows", &bFound ); if ( bFound ) pVar->SetIntValue( rt_shadows.GetInt() );
+	pVar = pMat->FindVar( "$rt_divisor", &bFound ); if ( bFound ) pVar->SetIntValue( clamp( rt_divisor.GetInt(), 1, 4 ) );
+	pVar = pMat->FindVar( "$rt_aorays", &bFound ); if ( bFound ) pVar->SetIntValue( clamp( rt_ao_rays.GetInt(), 1, 8 ) );
+	CMatRenderContextPtr pRenderContext( materials );
+	pRenderContext->DrawScreenSpaceQuad( pMat );
+
+	if ( rt_stats.GetBool() && ( s_nFrame % 300 ) == 0 )
+		Msg( "[rt] %s\n", pRT->GetStatus() );
+}
+
+CON_COMMAND( rt_status, "Ray tracing layer status" )
+{
+	IRayTracer *pRT = GetRayTracer();
+	Msg( "[rt] %s; world %s\n", pRT ? pRT->GetStatus() : "module unavailable", s_bWorldLoaded ? "loaded" : "not loaded" );
+}
+
+#else
+void RT_CaptureDepth() {}
+void RT_DrawComposite( const CViewSetup &view ) {}
+#endif
