--- /dev/null
+++ b/materialsystem/stdshaders/raytracecomposite.cpp
@@ -0,0 +1,139 @@
+//========= Ray tracing layer: composite shader (macOS arm64 port) ==============
+// The client draws a fullscreen quad with material "rt/composite" after the
+// 3D scene. This shader draws nothing itself; its dynamic pass runs on the
+// render thread with the GL context current and hands the frame to the Metal
+// ray tracer, which resolves depth, traces, and multiplies its result onto
+// the framebuffer through togl. Matrix/sun parameters travel as material vars
+// so they are in sync with the queued render thread.
+//=============================================================================
+#include "BaseVSShader.h"
+#include "screenspaceeffect_vs20.inc"
+#include "Bloom_ps20.inc"
+#include "Bloom_ps20b.inc"
+#include "rtmetal/iraytracer.h"
+#include "tier1/interface.h"
+#include "mathlib/vmatrix.h"
+
+static IRayTracer *s_pRayTracer = NULL;
+static bool s_bTriedLoad = false;
+
+static IRayTracer *GetRayTracer()
+{
+	if ( !s_bTriedLoad )
+	{
+		s_bTriedLoad = true;
+		CSysModule *pModule = Sys_LoadModule( "rtmetal" );
+		if ( pModule )
+		{
+			CreateInterfaceFn factory = Sys_GetFactory( pModule );
+			if ( factory )
+				s_pRayTracer = (IRayTracer *)factory( RAYTRACER_INTERFACE_VERSION, NULL );
+		}
+		if ( s_pRayTracer && !s_pRayTracer->Init() )
+			s_pRayTracer = NULL;
+		if ( !s_pRayTracer )
+			Warning( "[rt] rtmetal module unavailable; ray tracing disabled\n" );
+	}
+	return s_pRayTracer;
+}
+
+BEGIN_VS_SHADER_FLAGS( RayTraceComposite, "Ray tracing layer composite", SHADER_NOT_EDITABLE )
+	BEGIN_SHADER_PARAMS
+		SHADER_PARAM( RT_WORLDTOPROJ, SHADER_PARAM_TYPE_MATRIX, "", "world to projection matrix" )
+		SHADER_PARAM( RT_PROJTOWORLD, SHADER_PARAM_TYPE_MATRIX, "", "projection to world matrix" )
+		SHADER_PARAM( RT_CAMERAPOS, SHADER_PARAM_TYPE_VEC3, "[0 0 0]", "camera position" )
+		SHADER_PARAM( RT_SUNDIR, SHADER_PARAM_TYPE_VEC3, "[0 0 0]", "direction toward the sun" )
+		SHADER_PARAM( RT_AORADIUS, SHADER_PARAM_TYPE_FLOAT, "96", "" )
+		SHADER_PARAM( RT_AOSTRENGTH, SHADER_PARAM_TYPE_FLOAT, "0.8", "" )
+		SHADER_PARAM( RT_SHADOWSTRENGTH, SHADER_PARAM_TYPE_FLOAT, "0.6", "" )
+		SHADER_PARAM( RT_SUNANGLE, SHADER_PARAM_TYPE_FLOAT, "1.0", "" )
+		SHADER_PARAM( RT_FRAME, SHADER_PARAM_TYPE_INTEGER, "0", "" )
+		SHADER_PARAM( RT_DEBUG, SHADER_PARAM_TYPE_INTEGER, "0", "" )
+		SHADER_PARAM( RT_AO, SHADER_PARAM_TYPE_INTEGER, "1", "" )
+		SHADER_PARAM( RT_SHADOWS, SHADER_PARAM_TYPE_INTEGER, "1", "" )
+		SHADER_PARAM( RT_DIVISOR, SHADER_PARAM_TYPE_INTEGER, "2", "trace resolution divisor" )
+		SHADER_PARAM( RT_MODE, SHADER_PARAM_TYPE_INTEGER, "1", "0 = capture depth, 1 = trace and composite" )
+		SHADER_PARAM( RT_AORAYS, SHADER_PARAM_TYPE_INTEGER, "2", "AO rays per pixel per frame" )
+	END_SHADER_PARAMS
+
+	SHADER_INIT_PARAMS()
+	{
+	}
+
+	SHADER_INIT
+	{
+	}
+
+	SHADER_FALLBACK
+	{
+		return 0;
+	}
+
+	SHADER_DRAW
+	{
+		SHADOW_STATE
+		{
+			// A real shader pair must be bound or the (unimplemented) fixed-function
+			// transform path is used; colour writes are off so the quad itself draws nothing.
+			pShaderShadow->EnableDepthWrites( false );
+			pShaderShadow->EnableColorWrites( false );
+			pShaderShadow->EnableAlphaWrites( false );
+			pShaderShadow->VertexShaderVertexFormat( VERTEX_POSITION, 1, 0, 0 );
+			DECLARE_STATIC_VERTEX_SHADER( screenspaceeffect_vs20 );
+			SET_STATIC_VERTEX_SHADER( screenspaceeffect_vs20 );
+			if ( g_pHardwareConfig->SupportsPixelShaders_2_b() )
+			{
+				DECLARE_STATIC_PIXEL_SHADER( bloom_ps20b );
+				SET_STATIC_PIXEL_SHADER( bloom_ps20b );
+			}
+			else
+			{
+				DECLARE_STATIC_PIXEL_SHADER( bloom_ps20 );
+				SET_STATIC_PIXEL_SHADER( bloom_ps20 );
+			}
+		}
+		DYNAMIC_STATE
+		{
+			DECLARE_DYNAMIC_VERTEX_SHADER( screenspaceeffect_vs20 );
+			SET_DYNAMIC_VERTEX_SHADER( screenspaceeffect_vs20 );
+			if ( g_pHardwareConfig->SupportsPixelShaders_2_b() )
+			{
+				DECLARE_DYNAMIC_PIXEL_SHADER( bloom_ps20b );
+				SET_DYNAMIC_PIXEL_SHADER( bloom_ps20b );
+			}
+			else
+			{
+				DECLARE_DYNAMIC_PIXEL_SHADER( bloom_ps20 );
+				SET_DYNAMIC_PIXEL_SHADER( bloom_ps20 );
+			}
+			IRayTracer *pRT = GetRayTracer();
+			if ( pRT && params[RT_MODE]->GetIntValue() == 0 )
+			{
+				pRT->CaptureDepth( params[RT_DIVISOR]->GetIntValue() );
+			}
+			else if ( pRT )
+			{
+				RTFrameParams fp;
+				memset( &fp, 0, sizeof( fp ) );
+				const VMatrix &w2p = params[RT_WORLDTOPROJ]->GetMatrixValue();
+				const VMatrix &p2w = params[RT_PROJTOWORLD]->GetMatrixValue();
+				memcpy( fp.m_worldToProjection, w2p.Base(), sizeof( fp.m_worldToProjection ) );
+				memcpy( fp.m_projectionToWorld, p2w.Base(), sizeof( fp.m_projectionToWorld ) );
+				params[RT_CAMERAPOS]->GetVecValue( fp.m_cameraPos, 3 );
+				params[RT_SUNDIR]->GetVecValue( fp.m_sunDir, 3 );
+				fp.m_flAORadius = params[RT_AORADIUS]->GetFloatValue();
+				fp.m_flAOStrength = params[RT_AOSTRENGTH]->GetFloatValue();
+				fp.m_flShadowStrength = params[RT_SHADOWSTRENGTH]->GetFloatValue();
+				fp.m_flSunAngleDeg = params[RT_SUNANGLE]->GetFloatValue();
+				fp.m_nFrame = params[RT_FRAME]->GetIntValue();
+				fp.m_nDebugMode = params[RT_DEBUG]->GetIntValue();
+				fp.m_bAO = params[RT_AO]->GetIntValue();
+				fp.m_bShadows = params[RT_SHADOWS]->GetIntValue();
+				fp.m_nResolutionDivisor = params[RT_DIVISOR]->GetIntValue();
+				fp.m_nAORays = params[RT_AORAYS]->GetIntValue();
+				pRT->ApplyAndComposite( fp );
+			}
+		}
+		Draw();
+	}
+END_SHADER
