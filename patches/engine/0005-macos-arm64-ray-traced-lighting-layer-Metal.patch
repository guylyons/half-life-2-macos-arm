+//========= Ray tracing layer: GL side hooks (macOS arm64 port) =================
+//
+// Exposes the current drawing framebuffer's depth to the Metal ray tracer via an
+// IOSurface-backed texture, and composites the tracer's result back onto the
+// framebuffer. Everything here runs on the render thread with togl's GL context
+// current. GLSL is compiled directly (no Direct3D bytecode involved).
+//
+// Exported C entry points (looked up with dlsym by librtmetal.dylib):
+//   GLMRT_GetBackbufferInfo( int *w, int *h, int *msaa )
+//   GLMRT_ResolveDepth( IOSurfaceRef depthSurface )          // packs 24-bit depth into RGBA8
+//   GLMRT_Composite( IOSurfaceRef resultSurface, int rw, int rh ) // multiplies result onto backbuffer
+//=============================================================================
+#include "togl/rendermechanism.h"
+#include "togl/linuxwin/cglmfbo.h"
+#include "tier0/dbg.h"
+
+#ifdef OSX
+#include <OpenGL/OpenGL.h>
+#include <OpenGL/gl.h>
+#include <OpenGL/glext.h>
+#include <OpenGL/CGLIOSurface.h>
+#include <IOSurface/IOSurface.h>
+
+class CGLMRayTraceHooks
+{
+public:
+	static bool GetBackbufferInfo( int *pWidth, int *pHeight, int *pMSAA );
+	static bool ResolveDepth( IOSurfaceRef depthSurface );
+	static bool Composite( IOSurfaceRef resultSurface, int nResultWidth, int nResultHeight, bool bReplace );
+
+private:
+	static bool GetDrawingFBO( CGLMFBO **ppFBO, CGLMTex **ppDepthTex );
+	static GLuint SurfaceTexture( IOSurfaceRef surface, GLuint *pCachedName, IOSurfaceRef *pCachedSurface, int *pCachedW, int *pCachedH );
+	static GLuint BuildProgram( const char *pVertex, const char *pFragment );
+	static void DrawFullscreenQuad();
+
+	struct SavedState
+	{
+		GLint program, readFBO, drawFBO, arrayBuffer, activeTexture;
+	};
+	static void SaveState( SavedState &s );
+	static void RestoreState( const SavedState &s );
+
+	// resolve resources
+	static GLuint s_depthResolveFBO, s_depthResolveTex; static int s_depthResolveW, s_depthResolveH; static GLenum s_depthResolveIntFormat;
+	static GLuint s_depthPackFBO, s_depthPackTexName; static IOSurfaceRef s_depthPackSurface; static int s_depthPackW, s_depthPackH;
+	static GLuint s_packProgram, s_packProgramRect;
+	// composite resources
+	static GLuint s_resultTexName; static IOSurfaceRef s_resultSurface; static int s_resultW, s_resultH;
+	static GLuint s_compositeProgram;
+	static bool s_bFailed;
+};
+
+GLuint CGLMRayTraceHooks::s_depthResolveFBO = 0; GLuint CGLMRayTraceHooks::s_depthResolveTex = 0; int CGLMRayTraceHooks::s_depthResolveW = 0; int CGLMRayTraceHooks::s_depthResolveH = 0; GLenum CGLMRayTraceHooks::s_depthResolveIntFormat = 0;
+GLuint CGLMRayTraceHooks::s_depthPackFBO = 0; GLuint CGLMRayTraceHooks::s_depthPackTexName = 0; IOSurfaceRef CGLMRayTraceHooks::s_depthPackSurface = NULL; int CGLMRayTraceHooks::s_depthPackW = 0; int CGLMRayTraceHooks::s_depthPackH = 0;
+GLuint CGLMRayTraceHooks::s_packProgram = 0; GLuint CGLMRayTraceHooks::s_packProgramRect = 0;
+GLuint CGLMRayTraceHooks::s_resultTexName = 0; IOSurfaceRef CGLMRayTraceHooks::s_resultSurface = NULL; int CGLMRayTraceHooks::s_resultW = 0; int CGLMRayTraceHooks::s_resultH = 0;
+GLuint CGLMRayTraceHooks::s_compositeProgram = 0;
+bool CGLMRayTraceHooks::s_bFailed = false;
+
+static const char *s_pQuadVertexShader =
+	"#version 120\n"
+	"varying vec2 uv;\n"
+	"void main() { gl_Position = gl_Vertex; uv = gl_Vertex.xy * 0.5 + 0.5; }\n";
+
+// Packs the 24-bit depth into RGB bytes (hi, mid, lo); alpha unused.
+static const char *s_pPackFragmentShader =
+	"#version 120\n"
+	"varying vec2 uv;\n"
+	"uniform sampler2D depthTex;\n"
+	"void main() {\n"
+	"  float d = texture2D( depthTex, uv ).r;\n"
+	"  float v = floor( clamp( d, 0.0, 1.0 ) * 16777215.0 );\n"
+	"  float hi = floor( v / 65536.0 );\n"
+	"  float mid = floor( ( v - hi * 65536.0 ) / 256.0 );\n"
+	"  float lo = v - hi * 65536.0 - mid * 256.0;\n"
+	"  gl_FragColor = vec4( hi / 255.0, mid / 255.0, lo / 255.0, 1.0 );\n"
+	"}\n";
+
+// Result is an RGBA8 rectangle texture holding the modulation colour computed by Metal.
+static const char *s_pCompositeFragmentShader =
+	"#version 120\n"
+	"#extension GL_ARB_texture_rectangle : enable\n"
+	"varying vec2 uv;\n"
+	"uniform sampler2DRect resultTex;\n"
+	"uniform vec2 resultSize;\n"
+	"void main() { gl_FragColor = vec4( texture2DRect( resultTex, uv * resultSize ).rgb, 1.0 ); }\n";
+
+extern GLMContext *g_pGLMRTContext;
+
+bool CGLMRayTraceHooks::GetDrawingFBO( CGLMFBO **ppFBO, CGLMTex **ppDepthTex )
+{
+	GLMContext *ctx = g_pGLMRTContext;
+	if ( !ctx )
+		return false;
+	CGLMFBO *fbo = ctx->m_drawingFBO ? ctx->m_drawingFBO : ctx->m_boundDrawFBO;
+	if ( !fbo )
+		return false;
+	CGLMTex *depth = fbo->m_attach[ kAttDepthStencil ].m_tex;
+	if ( !depth )
+		depth = fbo->m_attach[ kAttDepth ].m_tex;
+	*ppFBO = fbo;
+	*ppDepthTex = depth;
+	return depth != NULL;
+}
+
+bool CGLMRayTraceHooks::GetBackbufferInfo( int *pWidth, int *pHeight, int *pMSAA )
+{
+	CGLMFBO *fbo; CGLMTex *depth;
+	if ( !GetDrawingFBO( &fbo, &depth ) )
+		return false;
+	*pWidth = depth->m_layout->m_key.m_xSize;
+	*pHeight = depth->m_layout->m_key.m_ySize;
+	*pMSAA = ( depth->m_layout->m_key.m_texFlags & kGLMTexMultisampled ) ? depth->m_layout->m_key.m_texSamples : 0;
+	return true;
+}
+
+GLuint CGLMRayTraceHooks::BuildProgram( const char *pVertex, const char *pFragment )
+{
+	GLuint vs = glCreateShader( GL_VERTEX_SHADER ), fs = glCreateShader( GL_FRAGMENT_SHADER );
+	glShaderSource( vs, 1, &pVertex, NULL ); glCompileShader( vs );
+	glShaderSource( fs, 1, &pFragment, NULL ); glCompileShader( fs );
+	GLint ok = 0;
+	glGetShaderiv( fs, GL_COMPILE_STATUS, &ok );
+	if ( !ok )
+	{
+		char log[2048]; glGetShaderInfoLog( fs, sizeof( log ), NULL, log );
+		Warning( "[rt] fragment shader failed: %s\n", log );
+		return 0;
+	}
+	GLuint prog = glCreateProgram();
+	glAttachShader( prog, vs ); glAttachShader( prog, fs ); glLinkProgram( prog );
+	glGetProgramiv( prog, GL_LINK_STATUS, &ok );
+	glDeleteShader( vs ); glDeleteShader( fs );
+	if ( !ok )
+	{
+		char log[2048]; glGetProgramInfoLog( prog, sizeof( log ), NULL, log );
+		Warning( "[rt] program link failed: %s\n", log );
+		return 0;
+	}
+	return prog;
+}
+
+GLuint CGLMRayTraceHooks::SurfaceTexture( IOSurfaceRef surface, GLuint *pCachedName, IOSurfaceRef *pCachedSurface, int *pCachedW, int *pCachedH )
+{
+	int w = (int)IOSurfaceGetWidth( surface ), h = (int)IOSurfaceGetHeight( surface );
+	if ( *pCachedName && *pCachedSurface == surface && *pCachedW == w && *pCachedH == h )
+		return *pCachedName;
+	if ( *pCachedName )
+		glDeleteTextures( 1, pCachedName );
+	GLuint tex = 0;
+	glGenTextures( 1, &tex );
+	glBindTexture( GL_TEXTURE_RECTANGLE_ARB, tex );
+	CGLError err = CGLTexImageIOSurface2D( CGLGetCurrentContext(), GL_TEXTURE_RECTANGLE_ARB, GL_RGBA8, w, h, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, surface, 0 );
+	glTexParameteri( GL_TEXTURE_RECTANGLE_ARB, GL_TEXTURE_MIN_FILTER, GL_NEAREST );
+	glTexParameteri( GL_TEXTURE_RECTANGLE_ARB, GL_TEXTURE_MAG_FILTER, GL_NEAREST );
+	glBindTexture( GL_TEXTURE_RECTANGLE_ARB, 0 );
+	if ( err != kCGLNoError )
+	{
+		Warning( "[rt] CGLTexImageIOSurface2D failed (%d)\n", (int)err );
+		glDeleteTextures( 1, &tex );
+		return 0;
+	}
+	*pCachedName = tex; *pCachedSurface = surface; *pCachedW = w; *pCachedH = h;
+	return tex;
+}
+
+void CGLMRayTraceHooks::SaveState( SavedState &s )
+{
+	glPushAttrib( GL_ALL_ATTRIB_BITS );
+	glPushClientAttrib( GL_CLIENT_ALL_ATTRIB_BITS );
+	glGetIntegerv( GL_CURRENT_PROGRAM, &s.program );
+	glGetIntegerv( GL_READ_FRAMEBUFFER_BINDING_EXT, &s.readFBO );
+	glGetIntegerv( GL_DRAW_FRAMEBUFFER_BINDING_EXT, &s.drawFBO );
+	glGetIntegerv( GL_ARRAY_BUFFER_BINDING_ARB, &s.arrayBuffer );
+	glGetIntegerv( GL_ACTIVE_TEXTURE, &s.activeTexture );
+}
+
+void CGLMRayTraceHooks::RestoreState( const SavedState &s )
+{
+	glBindFramebufferEXT( GL_READ_FRAMEBUFFER_EXT, s.readFBO );
+	glBindFramebufferEXT( GL_DRAW_FRAMEBUFFER_EXT, s.drawFBO );
+	glBindBufferARB( GL_ARRAY_BUFFER_ARB, s.arrayBuffer );
+	glUseProgram( s.program );
+	glActiveTexture( s.activeTexture );
+	glPopClientAttrib();
+	glPopAttrib();
+}
+
+void CGLMRayTraceHooks::DrawFullscreenQuad()
+{
+	glBegin( GL_TRIANGLE_STRIP );
+	glVertex2f( -1.0f, -1.0f ); glVertex2f( 1.0f, -1.0f ); glVertex2f( -1.0f, 1.0f ); glVertex2f( 1.0f, 1.0f );
+	glEnd();
+}
+
+bool CGLMRayTraceHooks::ResolveDepth( IOSurfaceRef depthSurface )
+{
+	if ( s_bFailed )
+		return false;
+	CGLMFBO *fbo; CGLMTex *depth;
+	if ( !GetDrawingFBO( &fbo, &depth ) )
+		return false;
+	int w = depth->m_layout->m_key.m_xSize, h = depth->m_layout->m_key.m_ySize;
+	bool bMSAA = ( depth->m_layout->m_key.m_texFlags & kGLMTexMultisampled ) != 0;
+
+	SavedState saved;
+	SaveState( saved );
+	while ( glGetError() != GL_NO_ERROR ) {}
+
+	if ( !s_packProgram )
+	{
+		s_packProgram = BuildProgram( s_pQuadVertexShader, s_pPackFragmentShader );
+		if ( !s_packProgram ) { s_bFailed = true; RestoreState( saved ); return false; }
+	}
+
+	// Source of the depth we sample: either the FBO's depth texture, or a single-sample resolve of its MSAA renderbuffer.
+	// Always go through our own single-sample depth texture: blitting works for the
+	// MSAA renderbuffer case, and togl's depth texture cannot be sampled directly.
+	GLuint depthTexName = depth->m_texName;
+	if ( bMSAA || true )
+	{
+		GLenum intFormat = depth->m_layout->m_format->m_glIntFormat;
+		if ( !s_depthResolveTex || s_depthResolveW != w || s_depthResolveH != h || s_depthResolveIntFormat != intFormat )
+		{
+			if ( s_depthResolveTex ) glDeleteTextures( 1, &s_depthResolveTex );
+			if ( s_depthResolveFBO ) glDeleteFramebuffersEXT( 1, &s_depthResolveFBO );
+			glGenTextures( 1, &s_depthResolveTex );
+			glBindTexture( GL_TEXTURE_2D, s_depthResolveTex );
+			glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST );
+			glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST );
+			glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_NONE );
+			glTexImage2D( GL_TEXTURE_2D, 0, intFormat, w, h, 0, depth->m_layout->m_format->m_glDataFormat, depth->m_layout->m_format->m_glDataType, NULL );
+			glGenFramebuffersEXT( 1, &s_depthResolveFBO );
+			glBindFramebufferEXT( GL_FRAMEBUFFER_EXT, s_depthResolveFBO );	// both bind points, so draw/read buffer state applies
+			GLenum attach = ( intFormat == GL_DEPTH24_STENCIL8_EXT ) ? GL_DEPTH_STENCIL_ATTACHMENT : GL_DEPTH_ATTACHMENT_EXT;
+			glFramebufferTexture2DEXT( GL_FRAMEBUFFER_EXT, attach, GL_TEXTURE_2D, s_depthResolveTex, 0 );
+			// depth-only framebuffer: no colour buffers, or it is incomplete
+			glDrawBuffer( GL_NONE );
+			glReadBuffer( GL_NONE );
+			s_depthResolveW = w; s_depthResolveH = h; s_depthResolveIntFormat = intFormat;
+		}
+		glBindFramebufferEXT( GL_READ_FRAMEBUFFER_EXT, fbo->m_name );
+		glBindFramebufferEXT( GL_DRAW_FRAMEBUFFER_EXT, s_depthResolveFBO );
+		glBlitFramebufferEXT( 0, 0, w, h, 0, 0, w, h, GL_DEPTH_BUFFER_BIT, GL_NEAREST );
+		depthTexName = s_depthResolveTex;
+	}
+
+	// Pack into the IOSurface texture.
+	GLuint packTex = SurfaceTexture( depthSurface, &s_depthPackTexName, &s_depthPackSurface, &s_depthPackW, &s_depthPackH );
+	if ( !packTex ) { s_bFailed = true; RestoreState( saved ); return false; }
+	if ( !s_depthPackFBO ) glGenFramebuffersEXT( 1, &s_depthPackFBO );
+	glBindFramebufferEXT( GL_FRAMEBUFFER_EXT, s_depthPackFBO );
+	glFramebufferTexture2DEXT( GL_FRAMEBUFFER_EXT, GL_COLOR_ATTACHMENT0_EXT, GL_TEXTURE_RECTANGLE_ARB, packTex, 0 );
+	glViewport( 0, 0, s_depthPackW, s_depthPackH );
+	glDisable( GL_DEPTH_TEST ); glDisable( GL_BLEND ); glDisable( GL_SCISSOR_TEST ); glDisable( GL_STENCIL_TEST ); glDisable( GL_CULL_FACE ); glDisable( GL_ALPHA_TEST );
+	glColorMask( GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE );
+	glUseProgram( s_packProgram );
+	glActiveTexture( GL_TEXTURE0 );
+	glBindTexture( GL_TEXTURE_2D, depthTexName );
+	glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_NONE );
+	glUniform1i( glGetUniformLocation( s_packProgram, "depthTex" ), 0 );
+	DrawFullscreenQuad();
+	glFinish();
+
+	GLenum err = glGetError();
+	RestoreState( saved );
+	if ( err != GL_NO_ERROR )
+	{
+		Warning( "[rt] GL error 0x%x in depth resolve; ray tracing disabled\n", err );
+		s_bFailed = true;
+		return false;
+	}
+	return true;
+}
+
+bool CGLMRayTraceHooks::Composite( IOSurfaceRef resultSurface, int nResultWidth, int nResultHeight, bool bReplace )
+{
+	if ( s_bFailed )
+		return false;
+	CGLMFBO *fbo; CGLMTex *depth;
+	if ( !GetDrawingFBO( &fbo, &depth ) )
+		return false;
+	int w = depth->m_layout->m_key.m_xSize, h = depth->m_layout->m_key.m_ySize;
+
+	SavedState saved;
+	SaveState( saved );
+	while ( glGetError() != GL_NO_ERROR ) {}
+
+	if ( !s_compositeProgram )
+	{
+		s_compositeProgram = BuildProgram( s_pQuadVertexShader, s_pCompositeFragmentShader );
+		if ( !s_compositeProgram ) { s_bFailed = true; RestoreState( saved ); return false; }
+	}
+	GLuint resultTex = SurfaceTexture( resultSurface, &s_resultTexName, &s_resultSurface, &s_resultW, &s_resultH );
+	if ( !resultTex ) { s_bFailed = true; RestoreState( saved ); return false; }
+
+	glBindFramebufferEXT( GL_FRAMEBUFFER_EXT, fbo->m_name );
+	glViewport( 0, 0, w, h );
+	glDisable( GL_DEPTH_TEST ); glDisable( GL_SCISSOR_TEST ); glDisable( GL_STENCIL_TEST ); glDisable( GL_CULL_FACE ); glDisable( GL_ALPHA_TEST );
+	glColorMask( GL_TRUE, GL_TRUE, GL_TRUE, GL_FALSE );
+	if ( bReplace )
+		glDisable( GL_BLEND );				// debug views replace the image
+	else
+	{
+		glEnable( GL_BLEND );
+		glBlendFunc( GL_DST_COLOR, GL_ZERO );	// multiply
+	}
+	glUseProgram( s_compositeProgram );
+	glActiveTexture( GL_TEXTURE0 );
+	glBindTexture( GL_TEXTURE_RECTANGLE_ARB, resultTex );
+	glTexParameteri( GL_TEXTURE_RECTANGLE_ARB, GL_TEXTURE_MIN_FILTER, GL_LINEAR );
+	glTexParameteri( GL_TEXTURE_RECTANGLE_ARB, GL_TEXTURE_MAG_FILTER, GL_LINEAR );
+	glUniform1i( glGetUniformLocation( s_compositeProgram, "resultTex" ), 0 );
+	glUniform2f( glGetUniformLocation( s_compositeProgram, "resultSize" ), (float)nResultWidth, (float)nResultHeight );
+	DrawFullscreenQuad();
+
+	GLenum err = glGetError();
+	RestoreState( saved );
+	if ( err != GL_NO_ERROR )
+	{
+		Warning( "[rt] GL error 0x%x in composite; ray tracing disabled\n", err );
+		s_bFailed = true;
+		return false;
+	}
+	return true;
+}
+
+extern "C" __attribute__((visibility("default"))) bool GLMRT_GetBackbufferInfo( int *pWidth, int *pHeight, int *pMSAA )
+{
+	return CGLMRayTraceHooks::GetBackbufferInfo( pWidth, pHeight, pMSAA );
+}
+extern "C" __attribute__((visibility("default"))) bool GLMRT_ResolveDepth( void *depthSurface )
+{
+	return CGLMRayTraceHooks::ResolveDepth( (IOSurfaceRef)depthSurface );
+}
+extern "C" __attribute__((visibility("default"))) bool GLMRT_Composite( void *resultSurface, int nResultWidth, int nResultHeight, int bReplace )
+{
+	return CGLMRayTraceHooks::Composite( (IOSurfaceRef)resultSurface, nResultWidth, nResultHeight, bReplace != 0 );
+}
