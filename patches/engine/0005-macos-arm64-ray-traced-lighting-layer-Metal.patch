diff --git a/public/rtmetal/iraytracer.h b/public/rtmetal/iraytracer.h
new file mode 100644
index 0000000..e69bf49
--- /dev/null
+++ b/public/rtmetal/iraytracer.h
@@ -0,0 +1,47 @@
+//========= Ray tracing layer interface (macOS arm64 port) =====================
+// Implemented by librtmetal.dylib (Metal). Consumed by the RayTraceComposite
+// shader (render thread) and the client (geometry upload at map load).
+//=============================================================================
+#ifndef IRAYTRACER_H
+#define IRAYTRACER_H
+#pragma once
+
+#include "interface.h"
+
+#define RAYTRACER_INTERFACE_VERSION "RayTracer001"
+
+struct RTFrameParams
+{
+	float	m_worldToProjection[16];	// row-major, D3D convention (clip z in 0..1), as from IVRenderView::GetMatricesForView
+	float	m_projectionToWorld[16];	// its inverse
+	float	m_cameraPos[3];
+	float	m_sunDir[3];				// unit vector pointing toward the sun (world space); zero if no sun
+	float	m_flAORadius;				// world units
+	float	m_flAOStrength;				// 0..1
+	float	m_flShadowStrength;			// 0..1
+	float	m_flSunAngleDeg;			// jitter cone half angle
+	int		m_nFrame;
+	int		m_nDebugMode;				// 0 off, 1 AO buffer, 2 shadow buffer, 3 normals, 4 depth
+	int		m_bAO;
+	int		m_bShadows;
+	int		m_nResolutionDivisor;		// 1 = full, 2 = half (default)
+	int		m_nAORays;					// AO rays per pixel per frame
+};
+
+abstract_class IRayTracer
+{
+public:
+	virtual bool Init() = 0;								// any thread, once; false if Metal ray tracing unavailable
+	virtual bool IsAvailable() = 0;
+	// Replaces the world geometry (copied). Triangles in world space; indices are triples.
+	virtual void SetWorldGeometry( const float *pVertsXYZ, int nVerts, const unsigned int *pIndices, int nTris ) = 0;
+	virtual void ClearWorld() = 0;
+	// Render thread only, GL context current.
+	// CaptureDepth: call right after the 3D scene is drawn (its depth is in the current drawing framebuffer).
+	virtual bool CaptureDepth( int nResolutionDivisor ) = 0;
+	// ApplyAndComposite: call when the final colour is in the current drawing framebuffer; traces using the captured depth.
+	virtual bool ApplyAndComposite( const RTFrameParams &params ) = 0;
+	virtual const char *GetStatus() = 0;
+};
+
+#endif // IRAYTRACER_H
