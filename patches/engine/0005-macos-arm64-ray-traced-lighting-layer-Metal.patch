diff --git a/rtmetal/rtmetal.mm b/rtmetal/rtmetal.mm
new file mode 100644
index 0000000..3500ccb
--- /dev/null
+++ b/rtmetal/rtmetal.mm
@@ -0,0 +1,538 @@
+//========= Ray tracing layer: Metal implementation (macOS arm64 port) ==========
+// Traces ambient occlusion and sun shadow rays against the level geometry using
+// the Metal ray tracing API (software on M1/M2, hardware on M3+), reading the
+// scene depth that togl resolves into an IOSurface and writing a modulation
+// image that togl multiplies onto the frame. See docs/superpowers/specs/
+// 2026-09-09-ray-tracing-design.md in the project repo.
+//=============================================================================
+#import <Metal/Metal.h>
+#import <IOSurface/IOSurface.h>
+#import <Foundation/Foundation.h>
+#include <dlfcn.h>
+#define DONT_DEFINE_BOOL	// Cocoa already has one
+#include <mutex>
+#include <vector>
+#include "rtmetal/iraytracer.h"
+#include "tier0/dbg.h"
+#include "tier1/interface.h"
+
+// togl hooks, resolved at run time
+typedef bool ( *GLMRT_GetBackbufferInfo_t )( int *, int *, int * );
+typedef bool ( *GLMRT_ResolveDepth_t )( void * );
+typedef bool ( *GLMRT_Composite_t )( void *, int, int, int );
+
+static const char *s_pKernels = R"MSL(
+#include <metal_stdlib>
+#include <metal_raytracing>
+using namespace metal;
+using namespace raytracing;
+
+struct Params {
+    float4x4 worldToProj;   // column-major as uploaded (we transpose on CPU)
+    float4x4 projToWorld;
+    float4x4 prevWorldToProj;
+    packed_float3 cameraPos; float aoRadius;   // packed: matches the C struct (float[3] + float)
+    packed_float3 sunDir; float aoStrength;
+    float shadowStrength; float sunCosAngle; int frame; int debugMode;
+    int aoEnabled; int shadowEnabled; int fullW; int fullH;
+    int halfW; int halfH; int hasSun; int historyValid;
+    int aoRays; int pad0; int pad1; int pad2;
+};
+
+// depth packed by togl: hi/mid/lo bytes of a 24-bit depth
+static float unpackDepth(float4 c) {
+    // togl writes GL_BGRA / 8_8_8_8_REV into the surface; Metal reads bgra8Unorm as rgba in that order
+    return (floor(c.r * 255.0 + 0.5) * 65536.0 + floor(c.g * 255.0 + 0.5) * 256.0 + floor(c.b * 255.0 + 0.5)) / 16777215.0;
+}
+
+// Texture row 0 is the GL framebuffer's bottom row; togl renders with Y flipped
+// relative to Source's Direct3D-style projection, so row 0 is the TOP of the
+// projected image: ndc.y = +1 at uv.y = 0.
+static float3 reconstruct(constant Params& p, float2 uv, float d) {
+    float4 ndc = float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, d, 1.0);
+    float4 w = p.projToWorld * ndc;
+    return w.xyz / w.w;
+}
+
+static float readDepth(texture2d<float, access::read> depthTex, int2 px, constant Params& p) {
+    px = clamp(px, int2(0), int2(p.fullW - 1, p.fullH - 1));
+    return unpackDepth(depthTex.read(uint2(px)));
+}
+
+static uint hash(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }
+static float rnd(thread uint& s) { s = hash(s); return float(s >> 8) * (1.0 / 16777216.0); }
+
+static float3 cosineHemisphere(float3 n, float u1, float u2) {
+    float r = sqrt(u1), phi = 6.28318530718 * u2;
+    float3 t = normalize(cross(abs(n.x) > 0.5 ? float3(0,1,0) : float3(1,0,0), n));
+    float3 b = cross(n, t);
+    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
+}
+
+// half-res: raw visibility (R = ao, G = sun), linear depth in B, normal encoded? keep B=view distance, A = valid
+kernel void trace(constant Params& p [[buffer(0)]],
+                  primitive_acceleration_structure accel [[buffer(1)]],
+                  texture2d<float, access::read> depthTex [[texture(0)]],
+                  texture2d<float, access::write> rawTex [[texture(1)]],
+                  texture2d<float, access::write> normalTex [[texture(2)]],
+                  uint2 gid [[thread_position_in_grid]])
+{
+    if (gid.x >= (uint)p.halfW || gid.y >= (uint)p.halfH) return;
+    int div = p.fullW / p.halfW;
+    int2 px = int2(gid) * div + div / 2;
+    float d = readDepth(depthTex, px, p);
+    if (d >= 0.99999) { rawTex.write(float4(1, 1, 0, 0), gid); normalTex.write(float4(0,0,0,0), gid); return; }
+    float2 uv = (float2(px) + 0.5) / float2(p.fullW, p.fullH);
+    float3 P = reconstruct(p, uv, d);
+    // normal from the depth neighbourhood: pick the neighbour pair with the smaller depth discontinuity
+    float2 texel = float2(div) / float2(p.fullW, p.fullH);
+    float dl = readDepth(depthTex, px - int2(div, 0), p), dr = readDepth(depthTex, px + int2(div, 0), p);
+    float dd = readDepth(depthTex, px - int2(0, div), p), du = readDepth(depthTex, px + int2(0, div), p);
+    float3 Px = (abs(dr - d) < abs(dl - d)) ? reconstruct(p, uv + float2(texel.x, 0), dr) - P : P - reconstruct(p, uv - float2(texel.x, 0), dl);
+    float3 Py = (abs(du - d) < abs(dd - d)) ? reconstruct(p, uv + float2(0, texel.y), du) - P : P - reconstruct(p, uv - float2(0, texel.y), dd);
+    float3 N = normalize(cross(Px, Py));
+    float3 V = normalize(float3(p.cameraPos) - P);
+    if (dot(N, V) < 0.0) N = -N;
+    float dist = length(float3(p.cameraPos) - P);
+    float bias = 0.5 + dist * 0.002;
+    float3 origin = P + N * bias;
+
+    intersector<triangle_data> isect;
+    isect.set_triangle_cull_mode(triangle_cull_mode::none);
+    isect.assume_geometry_type(geometry_type::triangle);
+    uint seed = hash(gid.x * 1973u + gid.y * 9277u + uint(p.frame) * 26699u);
+
+    float ao = 1.0;
+    if (p.aoEnabled) {
+        float sum = 0.0;
+        int n = max(p.aoRays, 1);
+        for (int i = 0; i < n; i++) {
+            float3 dir = cosineHemisphere(N, rnd(seed), rnd(seed));
+            ray r; r.origin = origin; r.direction = dir; r.min_distance = 0.0; r.max_distance = p.aoRadius;
+            intersection_result<triangle_data> res = isect.intersect(r, accel);
+            float v = 1.0;
+            if (res.type != intersection_type::none) {
+                // distance-weighted occlusion
+                v = clamp(res.distance / p.aoRadius, 0.0, 1.0);
+                v = v * v;
+            }
+            sum += v;
+        }
+        ao = sum / float(n);
+    }
+    float sun = 1.0;
+    if (p.shadowEnabled && p.hasSun) {
+        float3 sunDir = float3(p.sunDir);
+        float ndl = dot(N, sunDir);
+        if (ndl > 0.0) {
+            // jitter within the cone
+            float3 t = normalize(cross(abs(sunDir.x) > 0.5 ? float3(0,1,0) : float3(1,0,0), sunDir));
+            float3 b = cross(sunDir, t);
+            float u1 = rnd(seed), u2 = rnd(seed);
+            float cosA = mix(p.sunCosAngle, 1.0, u1), sinA = sqrt(1.0 - cosA * cosA), phi = 6.28318530718 * u2;
+            float3 dir = normalize(sunDir * cosA + t * (sinA * cos(phi)) + b * (sinA * sin(phi)));
+            ray r; r.origin = origin; r.direction = dir; r.min_distance = 0.0; r.max_distance = 16384.0;
+            intersection_result<triangle_data> res = isect.intersect(r, accel);
+            if (res.type != intersection_type::none) sun = 0.0;
+        }
+    }
+    rawTex.write(float4(ao, sun, dist, 1.0), gid);
+    normalTex.write(float4(N, 1.0), gid);
+}
+
+// temporal accumulation with reprojection; history: R ao, G sun, B dist, A sample count
+kernel void temporal(constant Params& p [[buffer(0)]],
+                     texture2d<float, access::read> rawTex [[texture(0)]],
+                     texture2d<float, access::read> depthTex [[texture(1)]],
+                     texture2d<float, access::sample> historyTex [[texture(2)]],
+                     texture2d<float, access::write> outTex [[texture(3)]],
+                     uint2 gid [[thread_position_in_grid]])
+{
+    if (gid.x >= (uint)p.halfW || gid.y >= (uint)p.halfH) return;
+    float4 raw = rawTex.read(gid);
+    if (raw.a == 0.0) { outTex.write(float4(1, 1, 0, 0), gid); return; }
+    int div = p.fullW / p.halfW;
+    int2 px = int2(gid) * div + div / 2;
+    float d = readDepth(depthTex, px, p);
+    float2 uv = (float2(px) + 0.5) / float2(p.fullW, p.fullH);
+    float3 P = reconstruct(p, uv, d);
+    float count = 0.0; float2 acc = raw.rg;
+    if (p.historyValid) {
+        float4 prev = p.prevWorldToProj * float4(P, 1.0);
+        if (prev.w > 0.0) {
+            float2 pndc = prev.xy / prev.w;
+            float2 puv = float2(pndc.x * 0.5 + 0.5, 0.5 - pndc.y * 0.5);
+            if (all(puv >= 0.0) && all(puv <= 1.0)) {
+                constexpr sampler s(filter::linear, address::clamp_to_edge);
+                float4 h = historyTex.sample(s, puv);
+                float prevDist = h.b;
+                float tol = 0.02 * max(raw.b, 1.0) + 2.0;
+                if (abs(prevDist - raw.b) < tol * 4.0 && h.a > 0.0) {
+                    count = min(h.a, 31.0);
+                    float w = 1.0 / (count + 1.0);
+                    acc = mix(h.rg, raw.rg, w);
+                }
+            }
+        }
+    }
+    outTex.write(float4(acc, raw.b, count + 1.0), gid);
+}
+
+// depth-aware 5x5 blur on the accumulated half-res buffer
+kernel void blur(constant Params& p [[buffer(0)]],
+                 texture2d<float, access::read> inTex [[texture(0)]],
+                 texture2d<float, access::read> normalTex [[texture(1)]],
+                 texture2d<float, access::write> outTex [[texture(2)]],
+                 uint2 gid [[thread_position_in_grid]])
+{
+    if (gid.x >= (uint)p.halfW || gid.y >= (uint)p.halfH) return;
+    float4 c = inTex.read(gid);
+    if (c.a == 0.0) { outTex.write(c, gid); return; }
+    float3 n = normalTex.read(gid).xyz;
+    // fewer samples once the history has converged
+    int radius = c.a >= 16.0 ? 1 : 2;
+    float2 sum = 0.0; float wsum = 0.0;
+    for (int dy = -radius; dy <= radius; dy++) for (int dx = -radius; dx <= radius; dx++) {
+        int2 q = clamp(int2(gid) + int2(dx, dy), int2(0), int2(p.halfW - 1, p.halfH - 1));
+        float4 s = inTex.read(uint2(q));
+        if (s.a == 0.0) continue;
+        float3 sn = normalTex.read(uint2(q)).xyz;
+        float w = exp(-abs(s.b - c.b) / (0.05 * c.b + 1.0)) * max(0.0, dot(n, sn));
+        sum += s.rg * w; wsum += w;
+    }
+    outTex.write(float4(wsum > 0.0 ? sum / wsum : c.rg, c.b, c.a), gid);
+}
+
+// full-res output: modulation colour (or a debug view), depth-aware upsample from half-res
+kernel void composite(constant Params& p [[buffer(0)]],
+                      texture2d<float, access::read> filteredTex [[texture(0)]],
+                      texture2d<float, access::read> depthTex [[texture(1)]],
+                      texture2d<float, access::read> normalTex [[texture(2)]],
+                      texture2d<float, access::write> resultTex [[texture(3)]],
+                      uint2 gid [[thread_position_in_grid]])
+{
+    if (gid.x >= (uint)p.fullW || gid.y >= (uint)p.fullH) return;
+    int div = p.fullW / p.halfW;
+    int2 h = clamp(int2(gid) / div, int2(0), int2(p.halfW - 1, p.halfH - 1));
+    float d = unpackDepth(depthTex.read(gid));
+    float4 out = float4(1.0);
+    if (d < 0.99999) {
+        float2 uv = (float2(gid) + 0.5) / float2(p.fullW, p.fullH);
+        float dist = length(float3(p.cameraPos) - reconstruct(p, uv, d));
+        // nearest of the 2x2 half-res neighbours by distance
+        float2 best = float2(1.0); float bestErr = 1e30;
+        for (int dy = 0; dy <= 1; dy++) for (int dx = 0; dx <= 1; dx++) {
+            int2 q = clamp(h + int2(dx, dy) - int2((int(gid.x) % div) < div/2 ? 1 : 0, (int(gid.y) % div) < div/2 ? 1 : 0), int2(0), int2(p.halfW - 1, p.halfH - 1));
+            float4 s = filteredTex.read(uint2(q));
+            if (s.a == 0.0) continue;
+            float err = abs(s.b - dist);
+            if (err < bestErr) { bestErr = err; best = s.rg; }
+        }
+        float ao = mix(1.0, best.r, p.aoStrength);
+        float sun = mix(1.0, best.g, p.shadowStrength);
+        out = float4(ao * sun, ao * sun, ao * sun, 1.0);
+        if (p.debugMode == 1) out = float4(best.r, best.r, best.r, 1.0);
+        else if (p.debugMode == 2) out = float4(best.g, best.g, best.g, 1.0);
+        else if (p.debugMode == 3) { float3 n = normalTex.read(uint2(h)).xyz; out = float4(n * 0.5 + 0.5, 1.0); }
+        else if (p.debugMode == 4) { float v = saturate(dist / 2048.0); out = float4(v, v, v, 1.0); }
+        else if (p.debugMode == 5) { float v = (d - 0.9) * 10.0; out = float4(saturate(v), saturate(v), saturate(v), 1.0); }
+        else if (p.debugMode == 6) { float3 P = reconstruct(p, uv, d); out = float4(fract(P / 256.0), 1.0); }
+    } else if (p.debugMode != 0) {
+        out = float4(0.0, 0.0, 0.0, 1.0);
+    }
+    resultTex.write(out, gid);
+}
+)MSL";
+
+struct RTParamsGPU
+{
+	float worldToProj[16]; float projToWorld[16]; float prevWorldToProj[16];
+	float cameraPos[3]; float aoRadius;
+	float sunDir[3]; float aoStrength;
+	float shadowStrength; float sunCosAngle; int frame; int debugMode;
+	int aoEnabled; int shadowEnabled; int fullW; int fullH;
+	int halfW; int halfH; int hasSun; int historyValid;
+	int aoRays; int pad0; int pad1; int pad2;
+};
+
+class CRayTracerMetal : public IRayTracer
+{
+public:
+	CRayTracerMetal() : m_bInit( false ), m_bAvailable( false ), m_pDevice( nil ), m_pQueue( nil ), m_pAccel( nil ), m_pPendingAccel( nil ),
+		m_depthSurface( NULL ), m_resultSurface( NULL ), m_nFullW( 0 ), m_nFullH( 0 ), m_nHalfW( 0 ), m_nHalfH( 0 ), m_nHistoryIndex( 0 ), m_bHistoryValid( false ),
+		m_pfnGetBackbufferInfo( NULL ), m_pfnResolveDepth( NULL ), m_pfnComposite( NULL ), m_bDepthCaptured( false ), m_flTimeResolve( 0 ), m_flTimeMetalWall( 0 ), m_flTimeMetalGPU( 0 ), m_flTimeComposite( 0 ), m_nTimedFrames( 0 ) { m_szStatus[0] = 0; m_szTiming[0] = 0; m_szStatusFull[0] = 0; }
+
+	virtual bool Init() OVERRIDE;
+	virtual bool IsAvailable() OVERRIDE { return m_bAvailable; }
+	virtual void SetWorldGeometry( const float *pVertsXYZ, int nVerts, const unsigned int *pIndices, int nTris ) OVERRIDE;
+	virtual void ClearWorld() OVERRIDE;
+	virtual bool CaptureDepth( int nResolutionDivisor ) OVERRIDE;
+	virtual bool ApplyAndComposite( const RTFrameParams &params ) OVERRIDE;
+	virtual const char *GetStatus() OVERRIDE { snprintf( m_szStatusFull, sizeof( m_szStatusFull ), "%s; %s", m_szStatus, m_szTiming ); return m_szStatusFull; }
+	bool m_bDepthCaptured;
+	double m_flTimeResolve, m_flTimeMetalWall, m_flTimeMetalGPU, m_flTimeComposite; int m_nTimedFrames; char m_szTiming[256]; char m_szStatusFull[512];
+
+private:
+	bool EnsureTargets( int w, int h, int divisor );
+	void SetStatus( const char *fmt, ... );
+
+	bool m_bInit, m_bAvailable;
+	id<MTLDevice> m_pDevice;
+	id<MTLCommandQueue> m_pQueue;
+	id<MTLComputePipelineState> m_pTrace, m_pTemporal, m_pBlur, m_pComposite;
+	std::mutex m_accelMutex;
+	id<MTLAccelerationStructure> m_pAccel, m_pPendingAccel;
+	id<MTLBuffer> m_pVertexBuffer, m_pIndexBuffer;	// keep alive while the structure references them
+	IOSurfaceRef m_depthSurface, m_resultSurface;
+	id<MTLTexture> m_pDepthTex, m_pResultTex, m_pRawTex, m_pNormalTex, m_pFilteredTex, m_pHistory[2];
+	int m_nFullW, m_nFullH, m_nHalfW, m_nHalfH, m_nHistoryIndex;
+	bool m_bHistoryValid;
+	float m_prevWorldToProj[16];
+	GLMRT_GetBackbufferInfo_t m_pfnGetBackbufferInfo;
+	GLMRT_ResolveDepth_t m_pfnResolveDepth;
+	GLMRT_Composite_t m_pfnComposite;
+	char m_szStatus[256];
+};
+
+void CRayTracerMetal::SetStatus( const char *fmt, ... )
+{
+	va_list ap; va_start( ap, fmt ); vsnprintf( m_szStatus, sizeof( m_szStatus ), fmt, ap ); va_end( ap );
+	Msg( "[rt] %s\n", m_szStatus );
+}
+
+bool CRayTracerMetal::Init()
+{
+	if ( m_bInit )
+		return m_bAvailable;
+	m_bInit = true;
+	@autoreleasepool
+	{
+		m_pDevice = [MTLCreateSystemDefaultDevice() retain];
+		if ( !m_pDevice ) { SetStatus( "no Metal device" ); return false; }
+		if ( ![m_pDevice supportsRaytracing] ) { SetStatus( "%s does not support Metal ray tracing", [[m_pDevice name] UTF8String] ); return false; }
+		m_pQueue = [[m_pDevice newCommandQueue] retain];
+		NSError *err = nil;
+		id<MTLLibrary> lib = [m_pDevice newLibraryWithSource:[NSString stringWithUTF8String:s_pKernels] options:nil error:&err];
+		if ( !lib ) { SetStatus( "kernel compile failed: %s", [[err localizedDescription] UTF8String] ); return false; }
+		struct { const char *name; id<MTLComputePipelineState> *out; } kernels[] = {
+			{ "trace", &m_pTrace }, { "temporal", &m_pTemporal }, { "blur", &m_pBlur }, { "composite", &m_pComposite } };
+		for ( auto &k : kernels )
+		{
+			id<MTLFunction> fn = [lib newFunctionWithName:[NSString stringWithUTF8String:k.name]];
+			*k.out = [[m_pDevice newComputePipelineStateWithFunction:fn error:&err] retain];
+			[fn release];
+			if ( !*k.out ) { SetStatus( "pipeline %s failed: %s", k.name, [[err localizedDescription] UTF8String] ); [lib release]; return false; }
+		}
+		[lib release];
+		m_pfnGetBackbufferInfo = (GLMRT_GetBackbufferInfo_t)dlsym( RTLD_DEFAULT, "GLMRT_GetBackbufferInfo" );
+		m_pfnResolveDepth = (GLMRT_ResolveDepth_t)dlsym( RTLD_DEFAULT, "GLMRT_ResolveDepth" );
+		m_pfnComposite = (GLMRT_Composite_t)dlsym( RTLD_DEFAULT, "GLMRT_Composite" );
+		if ( !m_pfnGetBackbufferInfo || !m_pfnResolveDepth || !m_pfnComposite ) { SetStatus( "togl hooks not found (libtogl.dylib without glmrt)" ); return false; }
+		m_bAvailable = true;
+		SetStatus( "ready on %s (%s ray tracing)", [[m_pDevice name] UTF8String], [m_pDevice supportsFamily:MTLGPUFamilyApple9] ? "hardware" : "software" );
+	}
+	return true;
+}
+
+void CRayTracerMetal::SetWorldGeometry( const float *pVertsXYZ, int nVerts, const unsigned int *pIndices, int nTris )
+{
+	if ( !m_bAvailable || nTris <= 0 || nVerts <= 0 )
+		return;
+	@autoreleasepool
+	{
+		double t0 = CFAbsoluteTimeGetCurrent();
+		// pad float3 to 16 bytes for the vertex stride Metal prefers
+		std::vector<float> padded( (size_t)nVerts * 4 );
+		for ( int i = 0; i < nVerts; i++ ) { padded[i*4] = pVertsXYZ[i*3]; padded[i*4+1] = pVertsXYZ[i*3+1]; padded[i*4+2] = pVertsXYZ[i*3+2]; padded[i*4+3] = 0; }
+		id<MTLBuffer> vb = [m_pDevice newBufferWithBytes:padded.data() length:padded.size() * sizeof( float ) options:MTLResourceStorageModeShared];
+		id<MTLBuffer> ib = [m_pDevice newBufferWithBytes:pIndices length:(size_t)nTris * 3 * sizeof( unsigned int ) options:MTLResourceStorageModeShared];
+		MTLAccelerationStructureTriangleGeometryDescriptor *geom = [MTLAccelerationStructureTriangleGeometryDescriptor descriptor];
+		geom.vertexBuffer = vb; geom.vertexStride = 16; geom.vertexFormat = MTLAttributeFormatFloat3;
+		geom.indexBuffer = ib; geom.indexType = MTLIndexTypeUInt32; geom.triangleCount = nTris;
+		geom.opaque = YES;
+		MTLPrimitiveAccelerationStructureDescriptor *desc = [MTLPrimitiveAccelerationStructureDescriptor descriptor];
+		desc.geometryDescriptors = @[ geom ];
+		MTLAccelerationStructureSizes sizes = [m_pDevice accelerationStructureSizesWithDescriptor:desc];
+		id<MTLAccelerationStructure> accel = [m_pDevice newAccelerationStructureWithSize:sizes.accelerationStructureSize];
+		id<MTLBuffer> scratch = [m_pDevice newBufferWithLength:sizes.buildScratchBufferSize options:MTLResourceStorageModePrivate];
+		id<MTLCommandBuffer> cb = [m_pQueue commandBuffer];
+		id<MTLAccelerationStructureCommandEncoder> enc = [cb accelerationStructureCommandEncoder];
+		[enc buildAccelerationStructure:accel descriptor:desc scratchBuffer:scratch scratchBufferOffset:0];
+		[enc endEncoding];
+		[cb commit];
+		[cb waitUntilCompleted];
+		[scratch release];
+		{
+			std::lock_guard<std::mutex> lock( m_accelMutex );
+			if ( m_pPendingAccel ) [m_pPendingAccel release];
+			m_pPendingAccel = [accel retain];
+			// buffers are swapped in on the render thread together with the structure
+			[m_pVertexBuffer release]; [m_pIndexBuffer release];
+			m_pVertexBuffer = [vb retain]; m_pIndexBuffer = [ib retain];
+		}
+		[accel release]; [vb release]; [ib release];
+		SetStatus( "world: %d triangles, BVH built in %.0f ms", nTris, ( CFAbsoluteTimeGetCurrent() - t0 ) * 1000.0 );
+	}
+}
+
+void CRayTracerMetal::ClearWorld()
+{
+	std::lock_guard<std::mutex> lock( m_accelMutex );
+	if ( m_pAccel ) { [m_pAccel release]; m_pAccel = nil; }
+	if ( m_pPendingAccel ) { [m_pPendingAccel release]; m_pPendingAccel = nil; }
+	m_bHistoryValid = false;
+}
+
+static id<MTLTexture> MakeTex( id<MTLDevice> dev, MTLPixelFormat fmt, int w, int h, IOSurfaceRef surface )
+{
+	MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:fmt width:w height:h mipmapped:NO];
+	td.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+	td.storageMode = MTLStorageModePrivate;
+	if ( surface )
+	{
+		td.storageMode = MTLStorageModeShared;
+		return [dev newTextureWithDescriptor:td iosurface:surface plane:0];
+	}
+	return [dev newTextureWithDescriptor:td];
+}
+
+bool CRayTracerMetal::EnsureTargets( int w, int h, int divisor )
+{
+	int hw = w / divisor, hh = h / divisor;
+	if ( m_nFullW == w && m_nFullH == h && m_nHalfW == hw && m_nHalfH == hh && m_depthSurface && m_resultSurface )
+		return true;
+	@autoreleasepool
+	{
+		[m_pDepthTex release]; [m_pResultTex release]; [m_pRawTex release]; [m_pNormalTex release]; [m_pFilteredTex release]; [m_pHistory[0] release]; [m_pHistory[1] release];
+		if ( m_depthSurface ) CFRelease( m_depthSurface );
+		if ( m_resultSurface ) CFRelease( m_resultSurface );
+		NSDictionary *props = @{ (id)kIOSurfaceWidth: @(w), (id)kIOSurfaceHeight: @(h), (id)kIOSurfaceBytesPerElement: @4, (id)kIOSurfacePixelFormat: @(0x42475241) };
+		m_depthSurface = IOSurfaceCreate( (CFDictionaryRef)props );
+		m_resultSurface = IOSurfaceCreate( (CFDictionaryRef)props );
+		if ( !m_depthSurface || !m_resultSurface ) { SetStatus( "IOSurface creation failed" ); return false; }
+		m_pDepthTex = MakeTex( m_pDevice, MTLPixelFormatBGRA8Unorm, w, h, m_depthSurface );
+		m_pResultTex = MakeTex( m_pDevice, MTLPixelFormatBGRA8Unorm, w, h, m_resultSurface );
+		m_pRawTex = MakeTex( m_pDevice, MTLPixelFormatRGBA16Float, hw, hh, NULL );
+		m_pNormalTex = MakeTex( m_pDevice, MTLPixelFormatRGBA16Float, hw, hh, NULL );
+		m_pFilteredTex = MakeTex( m_pDevice, MTLPixelFormatRGBA16Float, hw, hh, NULL );
+		m_pHistory[0] = MakeTex( m_pDevice, MTLPixelFormatRGBA16Float, hw, hh, NULL );
+		m_pHistory[1] = MakeTex( m_pDevice, MTLPixelFormatRGBA16Float, hw, hh, NULL );
+		m_nFullW = w; m_nFullH = h; m_nHalfW = hw; m_nHalfH = hh;
+		m_bHistoryValid = false;
+		SetStatus( "targets %dx%d (trace %dx%d)", w, h, hw, hh );
+	}
+	return true;
+}
+
+static void Transpose16( const float *in, float *out )
+{
+	// Source VMatrix is row-major (m[row][col]); Metal float4x4 constant is column-major
+	for ( int r = 0; r < 4; r++ ) for ( int c = 0; c < 4; c++ ) out[c*4 + r] = in[r*4 + c];
+}
+
+bool CRayTracerMetal::CaptureDepth( int nResolutionDivisor )
+{
+	m_bDepthCaptured = false;
+	if ( !m_bAvailable )
+		return false;
+	int w = 0, h = 0, msaa = 0;
+	if ( !m_pfnGetBackbufferInfo( &w, &h, &msaa ) || w <= 0 || h <= 0 )
+		return false;
+	int divisor = nResolutionDivisor >= 1 ? nResolutionDivisor : 2;
+	if ( !EnsureTargets( w, h, divisor ) )
+		return false;
+	double t0 = CFAbsoluteTimeGetCurrent();
+	m_bDepthCaptured = m_pfnResolveDepth( m_depthSurface );
+	m_flTimeResolve += ( CFAbsoluteTimeGetCurrent() - t0 ) * 1000.0;
+	return m_bDepthCaptured;
+}
+
+bool CRayTracerMetal::ApplyAndComposite( const RTFrameParams &params )
+{
+	if ( !m_bAvailable || !m_bDepthCaptured )
+		return false;
+	m_bDepthCaptured = false;
+	{
+		std::lock_guard<std::mutex> lock( m_accelMutex );
+		if ( m_pPendingAccel )
+		{
+			[m_pAccel release];
+			m_pAccel = m_pPendingAccel;
+			m_pPendingAccel = nil;
+			m_bHistoryValid = false;
+		}
+	}
+	if ( !m_pAccel )
+		return false;
+
+	@autoreleasepool
+	{
+		RTParamsGPU gp;
+		memset( &gp, 0, sizeof( gp ) );
+		Transpose16( params.m_worldToProjection, gp.worldToProj );
+		Transpose16( params.m_projectionToWorld, gp.projToWorld );
+		Transpose16( m_prevWorldToProj, gp.prevWorldToProj );
+		memcpy( gp.cameraPos, params.m_cameraPos, sizeof( gp.cameraPos ) );
+		memcpy( gp.sunDir, params.m_sunDir, sizeof( gp.sunDir ) );
+		gp.aoRadius = params.m_flAORadius > 1.0f ? params.m_flAORadius : 1.0f;
+		gp.aoStrength = params.m_flAOStrength; gp.shadowStrength = params.m_flShadowStrength;
+		gp.sunCosAngle = cosf( params.m_flSunAngleDeg * 3.14159265f / 180.0f );
+		gp.frame = params.m_nFrame; gp.debugMode = params.m_nDebugMode;
+		gp.aoEnabled = params.m_bAO; gp.shadowEnabled = params.m_bShadows;
+		gp.fullW = m_nFullW; gp.fullH = m_nFullH; gp.halfW = m_nHalfW; gp.halfH = m_nHalfH;
+		float sunLen = sqrtf( params.m_sunDir[0]*params.m_sunDir[0] + params.m_sunDir[1]*params.m_sunDir[1] + params.m_sunDir[2]*params.m_sunDir[2] );
+		gp.hasSun = sunLen > 0.5f;
+		gp.historyValid = m_bHistoryValid;
+		gp.aoRays = params.m_nAORays > 0 ? params.m_nAORays : 1;
+
+		double t0 = CFAbsoluteTimeGetCurrent();
+		id<MTLTexture> histIn = m_pHistory[m_nHistoryIndex], histOut = m_pHistory[m_nHistoryIndex ^ 1];
+		id<MTLCommandBuffer> cb = [m_pQueue commandBuffer];
+		id<MTLComputeCommandEncoder> ce = [cb computeCommandEncoder];
+		MTLSize tg = MTLSizeMake( 8, 8, 1 );
+		MTLSize halfGrid = MTLSizeMake( m_nHalfW, m_nHalfH, 1 ), fullGrid = MTLSizeMake( m_nFullW, m_nFullH, 1 );
+
+		[ce setComputePipelineState:m_pTrace];
+		[ce setBytes:&gp length:sizeof( gp ) atIndex:0];
+		[ce setAccelerationStructure:m_pAccel atBufferIndex:1];
+		[ce setTexture:m_pDepthTex atIndex:0]; [ce setTexture:m_pRawTex atIndex:1]; [ce setTexture:m_pNormalTex atIndex:2];
+		[ce dispatchThreads:halfGrid threadsPerThreadgroup:tg];
+
+		[ce setComputePipelineState:m_pTemporal];
+		[ce setBytes:&gp length:sizeof( gp ) atIndex:0];
+		[ce setTexture:m_pRawTex atIndex:0]; [ce setTexture:m_pDepthTex atIndex:1]; [ce setTexture:histIn atIndex:2]; [ce setTexture:histOut atIndex:3];
+		[ce dispatchThreads:halfGrid threadsPerThreadgroup:tg];
+
+		[ce setComputePipelineState:m_pBlur];
+		[ce setBytes:&gp length:sizeof( gp ) atIndex:0];
+		[ce setTexture:histOut atIndex:0]; [ce setTexture:m_pNormalTex atIndex:1]; [ce setTexture:m_pFilteredTex atIndex:2];
+		[ce dispatchThreads:halfGrid threadsPerThreadgroup:tg];
+
+		[ce setComputePipelineState:m_pComposite];
+		[ce setBytes:&gp length:sizeof( gp ) atIndex:0];
+		[ce setTexture:m_pFilteredTex atIndex:0]; [ce setTexture:m_pDepthTex atIndex:1]; [ce setTexture:m_pNormalTex atIndex:2]; [ce setTexture:m_pResultTex atIndex:3];
+		[ce dispatchThreads:fullGrid threadsPerThreadgroup:tg];
+		[ce endEncoding];
+		[cb commit];
+		[cb waitUntilCompleted];
+		m_flTimeMetalGPU += ( cb.GPUEndTime - cb.GPUStartTime ) * 1000.0;
+		m_flTimeMetalWall += ( CFAbsoluteTimeGetCurrent() - t0 ) * 1000.0;
+
+		m_nHistoryIndex ^= 1;
+		m_bHistoryValid = true;
+		memcpy( m_prevWorldToProj, params.m_worldToProjection, sizeof( m_prevWorldToProj ) );
+	}
+	double t1 = CFAbsoluteTimeGetCurrent();
+	bool bOK = m_pfnComposite( m_resultSurface, m_nFullW, m_nFullH, params.m_nDebugMode != 0 );
+	m_flTimeComposite += ( CFAbsoluteTimeGetCurrent() - t1 ) * 1000.0;
+	if ( ++m_nTimedFrames >= 120 )
+	{
+		snprintf( m_szTiming, sizeof( m_szTiming ), "per frame: depth resolve %.2f ms, metal %.2f ms wall (%.2f ms GPU), composite %.2f ms; trace %dx%d",
+			m_flTimeResolve / m_nTimedFrames, m_flTimeMetalWall / m_nTimedFrames, m_flTimeMetalGPU / m_nTimedFrames, m_flTimeComposite / m_nTimedFrames, m_nHalfW, m_nHalfH );
+		m_flTimeResolve = m_flTimeMetalWall = m_flTimeMetalGPU = m_flTimeComposite = 0.0; m_nTimedFrames = 0;
+	}
+	return bOK;
+}
+
+static CRayTracerMetal s_RayTracer;
+EXPOSE_SINGLE_INTERFACE_GLOBALVAR( CRayTracerMetal, IRayTracer, RAYTRACER_INTERFACE_VERSION, s_RayTracer );
