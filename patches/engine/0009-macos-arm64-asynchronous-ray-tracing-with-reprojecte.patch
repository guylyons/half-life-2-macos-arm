+			{
+				if ( waited >= nTimeoutNs ) return false;
+				usleep( 100 ); waited += 100000;
+			}
+		}
+		else if ( !glTestFenceAPPLE( f ) )
+			return false;
+		glDeleteFencesAPPLE( 1, &f );
+		return true;
+	}
+	GLenum r = glClientWaitSync( (GLsync)pFence, 0, nTimeoutNs );
+	if ( r == GL_ALREADY_SIGNALED || r == GL_CONDITION_SATISFIED )
+	{
+		glDeleteSync( (GLsync)pFence );
+		return true;
+	}
+	return false;
