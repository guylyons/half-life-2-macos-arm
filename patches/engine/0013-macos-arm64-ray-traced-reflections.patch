+//-----------------------------------------------------------------------------
+// Material classification for reflections: a surface reflects if its material has an
+// environment map. Water is left to the engine's own mirrored render.
+//-----------------------------------------------------------------------------
+// Average colour and alpha of a VTF, from its smallest mip level (VTFs store mips smallest first).
+// Returns false if the file is missing or the format is not handled.
+static bool VTFAverage( const char *pTexName, float *pRGBA )
+{
+	char path[MAX_PATH];
+	V_snprintf( path, sizeof( path ), "materials/%s.vtf", pTexName );
+	V_FixSlashes( path, '/' );
+	V_strlower( path );		// VPK paths are lower case; material files reference textures in mixed case
+	CUtlBuffer buf;
+	if ( !filesystem->ReadFile( path, "GAME", buf ) || buf.TellPut() < 80 )
+		return false;
+	const byte *p = (const byte *)buf.Base();
+	int nSize = buf.TellPut();
+	if ( memcmp( p, "VTF\0", 4 ) != 0 )
+		return false;
+	unsigned int verMajor = *(const unsigned int *)( p + 4 ), verMinor = *(const unsigned int *)( p + 8 );
+	unsigned int headerSize = *(const unsigned int *)( p + 12 );
+	unsigned int imageFormat = *(const unsigned int *)( p + 52 );
+	unsigned int lowResFormat = *(const unsigned int *)( p + 57 );
+	int lowW = p[61], lowH = p[62];
+	unsigned int dataOfs = 0;
+	if ( verMajor == 7 && verMinor >= 3 )
+	{
+		unsigned int nRes = *(const unsigned int *)( p + 68 );
+		const byte *pRes = p + 80;
+		for ( unsigned int i = 0; i < nRes && (unsigned int)( 80 + i * 8 + 8 ) <= headerSize; i++ )
+		{
+			if ( pRes[i*8] == 0x30 && pRes[i*8+1] == 0 && pRes[i*8+2] == 0 )
+				dataOfs = *(const unsigned int *)( pRes + i * 8 + 4 );
+		}
+		if ( !dataOfs ) return false;
+	}
+	else
+	{
+		unsigned int lowSize = ( lowResFormat == 13 && lowW > 0 && lowH > 0 ) ? ( ( lowW + 3 ) / 4 ) * ( ( lowH + 3 ) / 4 ) * 8 : 0;
+		dataOfs = headerSize + lowSize;
+	}
+	if ( dataOfs + 16 > (unsigned int)nSize )
+		return false;
+	const byte *d = p + dataOfs;	// the 1x1 mip
+	auto c565 = []( unsigned short c, float *rgb ) { rgb[0] = ( ( c >> 11 ) & 31 ) / 31.0f; rgb[1] = ( ( c >> 5 ) & 63 ) / 63.0f; rgb[2] = ( c & 31 ) / 31.0f; };
+	switch ( imageFormat )
+	{
+		case 13: { float a[3], b[3]; c565( *(const unsigned short *)d, a ); c565( *(const unsigned short *)( d + 2 ), b ); for ( int i = 0; i < 3; i++ ) pRGBA[i] = 0.5f * ( a[i] + b[i] ); pRGBA[3] = 1.0f; return true; }		// DXT1
+		case 14: { float al = 0; for ( int i = 0; i < 8; i++ ) al += ( d[i] & 15 ) + ( d[i] >> 4 ); pRGBA[3] = al / ( 16.0f * 15.0f );
+				   float a[3], b[3]; c565( *(const unsigned short *)( d + 8 ), a ); c565( *(const unsigned short *)( d + 10 ), b ); for ( int i = 0; i < 3; i++ ) pRGBA[i] = 0.5f * ( a[i] + b[i] ); return true; }	// DXT3
+		case 15: { pRGBA[3] = 0.5f * ( d[0] + d[1] ) / 255.0f;
+				   float a[3], b[3]; c565( *(const unsigned short *)( d + 8 ), a ); c565( *(const unsigned short *)( d + 10 ), b ); for ( int i = 0; i < 3; i++ ) pRGBA[i] = 0.5f * ( a[i] + b[i] ); return true; }	// DXT5
+		case 0: pRGBA[0] = d[0] / 255.0f; pRGBA[1] = d[1] / 255.0f; pRGBA[2] = d[2] / 255.0f; pRGBA[3] = d[3] / 255.0f; return true;		// RGBA8888
+		case 12: pRGBA[0] = d[2] / 255.0f; pRGBA[1] = d[1] / 255.0f; pRGBA[2] = d[0] / 255.0f; pRGBA[3] = d[3] / 255.0f; return true;		// BGRA8888
+		case 16: pRGBA[0] = d[2] / 255.0f; pRGBA[1] = d[1] / 255.0f; pRGBA[2] = d[0] / 255.0f; pRGBA[3] = 1.0f; return true;				// BGRX8888
+		case 2: pRGBA[0] = d[0] / 255.0f; pRGBA[1] = d[1] / 255.0f; pRGBA[2] = d[2] / 255.0f; pRGBA[3] = 1.0f; return true;				// RGB888
+		case 3: pRGBA[0] = d[2] / 255.0f; pRGBA[1] = d[1] / 255.0f; pRGBA[2] = d[0] / 255.0f; pRGBA[3] = 1.0f; return true;				// BGR888
+		case 5: pRGBA[0] = pRGBA[1] = pRGBA[2] = d[0] / 255.0f; pRGBA[3] = 1.0f; return true;											// I8
+		case 6: pRGBA[0] = pRGBA[1] = pRGBA[2] = d[0] / 255.0f; pRGBA[3] = d[1] / 255.0f; return true;									// IA88
+		case 8: pRGBA[0] = pRGBA[1] = pRGBA[2] = 1.0f; pRGBA[3] = d[0] / 255.0f; return true;												// A8
+	}
+	return false;
+}
+
+// Average of a mask texture named by a material var; flDefault when the var is unset or the file unreadable.
+static float MaskAverageFromVar( IMaterial *pMat, const char *pVarName, bool bAlpha, float flDefault )
+{
+	bool bFound = false;
+	IMaterialVar *pVar = pMat->FindVar( pVarName, &bFound, false );
+	if ( !bFound || !pVar || !pVar->IsDefined() )
+		return flDefault;
+	const char *pName = pVar->GetStringValue();
+	if ( !pName || !pName[0] || pName[0] == '<' )
+		return flDefault;
+	float rgba[4];
+	if ( !VTFAverage( pName, rgba ) )
+		return flDefault;
+	return bAlpha ? rgba[3] : ( rgba[0] + rgba[1] + rgba[2] ) / 3.0f;
+}
+
+static bool VarIsSet( IMaterial *pMat, const char *pVarName )
+{
+	bool bFound = false;
+	IMaterialVar *pVar = pMat->FindVar( pVarName, &bFound, false );
+	return bFound && pVar && pVar->IsDefined();
+}
+
+static bool ClassifyReflective( IMaterial *pMat, float *pflReflectivity, float *pTint )
+{
+	pTint[0] = pTint[1] = pTint[2] = 1.0f;
+	*pflReflectivity = 0.0f;
+	if ( !pMat || pMat->IsErrorMaterial() )
+		return false;
+	bool bFound = false;
+	pMat->FindVar( "$reflecttexture", &bFound, false );
+	if ( bFound )
+		return false;		// water
+	IMaterialVar *pEnv = pMat->FindVar( "$envmap", &bFound, false );
+	if ( !bFound || !pEnv || !pEnv->IsDefined() )
+		return false;
+	const char *pName = pEnv->GetStringValue();
+	if ( !pName || !pName[0] )
+		return false;
+	float r = 1.0f;
+	IMaterialVar *pTintVar = pMat->FindVar( "$envmaptint", &bFound, false );
+	if ( bFound && pTintVar )
+	{
+		float t[3] = { 1, 1, 1 };
+		if ( pTintVar->GetType() == MATERIAL_VAR_TYPE_VECTOR ) pTintVar->GetVecValue( t, 3 );
+		else { t[0] = t[1] = t[2] = pTintVar->GetFloatValue(); }
+		float mx = MAX( t[0], MAX( t[1], t[2] ) );
+		if ( mx <= 0.0f ) return false;
+		r = MIN( mx, 1.0f );
+		for ( int i = 0; i < 3; i++ ) pTint[i] = clamp( t[i] / mx, 0.0f, 1.0f );
+	}
+	// Per-pixel masks are not available to the tracer; each mask contributes its average, read
+	// from the texture's smallest mip. The base-alpha mask is inverted in the shaders.
+	if ( VarIsSet( pMat, "$envmapmask" ) )
+		r *= MaskAverageFromVar( pMat, "$envmapmask", false, 0.3f );
+	if ( pMat->GetMaterialVarFlag( MATERIAL_VAR_NORMALMAPALPHAENVMAPMASK ) )
+		r *= MaskAverageFromVar( pMat, "$bumpmap", true, 0.3f );
+	if ( pMat->GetMaterialVarFlag( MATERIAL_VAR_BASEALPHAENVMAPMASK ) )
+		r *= 1.0f - MaskAverageFromVar( pMat, "$basetexture", true, 0.7f );
+	*pflReflectivity = r;
+	return r > 0.01f;
+}
+
+static void MaterialFlatColor( IMaterial *pMat, const Vector &vLight, float *pFlat )
+{
+	Vector refl( 0.5f, 0.5f, 0.5f );
+	if ( pMat && !pMat->IsErrorMaterial() )
+		pMat->GetReflectivity( refl );
+	for ( int i = 0; i < 3; i++ )
+		pFlat[i] = powf( clamp( refl[i] * vLight[i], 0.0f, 1.0f ), 1.0f / 2.2f );
+}
