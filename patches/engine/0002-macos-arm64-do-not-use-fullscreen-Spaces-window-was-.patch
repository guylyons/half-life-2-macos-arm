From efecf594f00747463458ed633968ff865ba83372 Mon Sep 17 00:00:00 2001
From: Guy Lyons <guylyons2@gmail.com>
Date: Wed, 9 Sep 2026 15:04:58 -0400
Subject: [PATCH 02/14] macos-arm64: do not use fullscreen Spaces (window was
 screen minus menu bar, offsetting mouse and clipping)

---
 appframework/sdlmgr.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/appframework/sdlmgr.cpp b/appframework/sdlmgr.cpp
index 352402f..e1a542c 100644
--- a/appframework/sdlmgr.cpp
+++ b/appframework/sdlmgr.cpp
@@ -521,6 +521,15 @@ InitReturnVal_t CSDLMgr::Init()
 
 	if (!SDL_WasInit(SDL_INIT_VIDEO))
 	{
+#ifdef OSX
+		// Do not use macOS fullscreen Spaces for SDL_WINDOW_FULLSCREEN_DESKTOP.
+		// With Spaces (SDL3 via sdl2-compat on Apple Silicon) the window ends up
+		// sized to the screen minus the menu bar (e.g. 1512x949 for a 1512x982
+		// display) while the engine renders the full desktop size, so the image
+		// is clipped and the mouse is offset by the menu bar height. The classic
+		// path gives a window exactly the size of the desktop mode.
+		SDL_SetHint( SDL_HINT_VIDEO_MAC_FULLSCREEN_SPACES, "0" );
+#endif
 		if (SDL_Init(SDL_INIT_VIDEO) == -1)
 			Error( "SDL_Init(SDL_INIT_VIDEO) failed: %s", SDL_GetError() );
 
-- 
