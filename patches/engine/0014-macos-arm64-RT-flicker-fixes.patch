 game/client/viewrender.cpp  | 11 ++---
 public/rtmetal/iraytracer.h |  1 +
 rtmetal/rtmetal.mm          | 89 +++++++++++++++++++++++++++----------
 togl/linuxwin/glmrt.cpp     |  2 +-
 5 files changed, 80 insertions(+), 33 deletions(-)

